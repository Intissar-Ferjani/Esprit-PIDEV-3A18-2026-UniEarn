<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniearn.controller.ProjectController"
            style="-fx-background-color: #F8F9FA;">

    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #2563EB; -fx-padding: 20;">
            <Label text="UniEarn - Gestion des Projets" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="24"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Rafraîchir" onAction="#handleRefresh"
                    style="-fx-background-color: #FFFFFF; -fx-text-fill: #2563EB;
                           -fx-font-weight: bold; -fx-background-radius: 8;
                           -fx-cursor: hand; -fx-padding: 10 20;">
                <font>
                    <Font size="14"/>
                </font>
            </Button>
        </HBox>
    </top>

    <!-- Main Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">

            <!-- Form Section -->
            <VBox spacing="15" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12;
                                      -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                <Label text="Informations du Projet" textFill="#2563EB">
                    <font>
                        <Font name="System Bold" size="20"/>
                    </font>
                </Label>

                <Separator style="-fx-background-color: #E5E7EB;"/>

                <GridPane hgap="20" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>

                    <!-- Row 0: Title -->
                    <Label text="Titre du projet" textFill="#374151" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <font>
                            <Font name="System Bold" size="14"/>
                        </font>
                    </Label>
                    <TextField fx:id="titleField" promptText="Entrez le titre du projet"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;
                                      -fx-font-size: 14;">
                    </TextField>

                    <!-- Row 0: Budget -->
                    <Label text="Budget (TND)" textFill="#374151" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <font>
                            <Font name="System Bold" size="14"/>
                        </font>
                    </Label>
                    <TextField fx:id="budgetField" promptText="0.00"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;
                                      -fx-font-size: 14;">
                    </TextField>

                    <!-- Row 2: Status -->
                    <Label text="Statut" textFill="#374151" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <font>
                            <Font name="System Bold" size="14"/>
                        </font>
                    </Label>
                    <ComboBox fx:id="statusComboBox" promptText="Sélectionnez le statut"
                              GridPane.columnIndex="0" GridPane.rowIndex="3" maxWidth="Infinity"
                              style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                     -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;
                                     -fx-font-size: 14;">
                    </ComboBox>

                    <!-- Row 2: Client ID -->
                    <Label text="ID Client" textFill="#374151" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <font>
                            <Font name="System Bold" size="14"/>
                        </font>
                    </Label>
                    <TextField fx:id="clientIdField" promptText="ID du client"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;
                                      -fx-font-size: 14;">
                    </TextField>

                    <!-- Row 4: Description (spans 2 columns) -->
                    <Label text="Description" textFill="#374151" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                        <font>
                            <Font name="System Bold" size="14"/>
                        </font>
                    </Label>
                    <TextArea fx:id="descriptionArea" promptText="Décrivez le projet en détail..."
                              GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"
                              prefRowCount="4" wrapText="true"
                              style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                     -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12;
                                     -fx-font-size: 14;">
                    </TextArea>
                </GridPane>

                <!-- Action Buttons -->
                <HBox spacing="15" alignment="CENTER">
                    <Button fx:id="addButton" text="Ajouter" onAction="#handleAdd" prefWidth="150"
                            style="-fx-background-color: #20C997; -fx-text-fill: #FFFFFF;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-cursor: hand; -fx-padding: 12 0; -fx-font-size: 15;">
                    </Button>

                    <Button fx:id="updateButton" text="Modifier" onAction="#handleUpdate" prefWidth="150"
                            style="-fx-background-color: #2563EB; -fx-text-fill: #FFFFFF;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-cursor: hand; -fx-padding: 12 0; -fx-font-size: 15;">
                    </Button>

                    <Button fx:id="clearButton" text="Clear" onAction="#handleClear" prefWidth="150"
                            style="-fx-background-color: #6B7280; -fx-text-fill: #FFFFFF;
                                   -fx-font-weight: bold; -fx-background-radius: 8;
                                   -fx-cursor: hand; -fx-padding: 12 0; -fx-font-size: 15;">
                    </Button>
                </HBox>
            </VBox>

            <!-- Table Section -->
            <VBox spacing="15" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12;
                                      -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                <HBox alignment="CENTER_LEFT">
                    <Label text="Liste des Projets" textFill="#2563EB">
                        <font>
                            <Font name="System Bold" size="20"/>
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField" promptText="🔍 Rechercher un projet..."
                               prefWidth="300"
                               style="-fx-background-color: #F9FAFB; -fx-border-color: #D1D5DB;
                                      -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10;">
                    </TextField>
                </HBox>

                <Separator style="-fx-background-color: #E5E7EB;"/>

                <TableView fx:id="projectTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #FFFFFF; -fx-table-cell-border-color: #E5E7EB;">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="titleColumn" text="Titre" prefWidth="200"/>
                        <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300"/>
                        <TableColumn fx:id="budgetColumn" text="Budget (TND)" prefWidth="120"
                                     style="-fx-alignment: CENTER-RIGHT;"/>
                        <TableColumn fx:id="statusColumn" text="Statut" prefWidth="150"
                                     style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="clientIdColumn" text="ID Client" prefWidth="100"
                                     style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun projet disponible" textFill="#6B7280">
                            <font>
                                <Font size="16"/>
                            </font>
                        </Label>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #F3F4F6; -fx-padding: 15;">
            <Label fx:id="statusLabel" text="Prêt" textFill="#374151">
                <font>
                    <Font size="14"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" text="Total: 0 projets" textFill="#6B7280">
                <font>
                    <Font name="System Bold" size="14"/>
                </font>
            </Label>
        </HBox>
    </bottom>

</BorderPane>
