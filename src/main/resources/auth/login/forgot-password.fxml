<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="550.0" prefWidth="750.0" styleClass="root"
            stylesheets="@../auth.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniearn.controller.auth.user.ForgotPasswordController">

    <!-- Left Panel -->
    <VBox alignment="CENTER" prefHeight="550.0" prefWidth="300.0"
          styleClass="left-panel"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <Label text="🎓" style="-fx-font-size:48px;"/>
            <Label styleClass="brand-title" text="UniEarn">
                <font><Font name="System Bold" size="36.0"/></font>
            </Label>
            <Label styleClass="brand-subtitle" text="Réinitialiser">
                <font><Font size="18.0"/></font>
                <VBox.margin><Insets top="10.0"/></VBox.margin>
            </Label>
            <Label styleClass="brand-subtitle" text="votre mot de passe">
                <font><Font size="14.0"/></font>
                <VBox.margin><Insets top="5.0"/></VBox.margin>
            </Label>
        </children>
    </VBox>

    <!-- Right Panel -->
    <VBox alignment="CENTER" layoutX="300.0" prefHeight="550.0" prefWidth="450.0"
          styleClass="form-panel" spacing="0.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding><Insets bottom="40.0" left="50.0" right="50.0" top="40.0"/></padding>
        <children>

            <Label text="Mot de passe oublié ?" styleClass="form-title">
                <font><Font name="System Bold" size="26.0"/></font>
            </Label>
            <Label text="Entrez votre email pour recevoir un code" styleClass="form-subtitle">
                <VBox.margin><Insets bottom="24.0" top="6.0"/></VBox.margin>
            </Label>

            <!-- Status Label -->
            <Label fx:id="statusLabel" styleClass="helper-text" text="" wrapText="true">
                <VBox.margin><Insets bottom="10.0"/></VBox.margin>
            </Label>

            <!-- ── STEP 1: Email ── -->
            <VBox fx:id="emailStep" spacing="14.0">
                <children>
                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="Adresse email">
                                <font><Font name="System Bold" size="13.0"/></font>
                            </Label>
                            <TextField fx:id="emailField" promptText="votre@email.com" styleClass="custom-field">
                                <font><Font size="14.0"/></font>
                            </TextField>
                            <Label fx:id="emailError" styleClass="error-label" visible="false"/>
                        </children>
                    </VBox>

                    <Button fx:id="sendCodeButton" text="Envoyer le code"
                            onAction="#handleSendCode"
                            prefHeight="45.0" prefWidth="350.0"
                            styleClass="signup-button">
                        <font><Font name="System Bold" size="14.0"/></font>
                        <VBox.margin><Insets top="8.0"/></VBox.margin>
                    </Button>
                </children>
            </VBox>

            <!-- ── STEP 2: Code + New Password ── -->
            <VBox fx:id="resetStep" spacing="14.0" visible="false" managed="false">
                <children>

                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="Code reçu par email">
                                <font><Font name="System Bold" size="13.0"/></font>
                            </Label>
                            <TextField fx:id="codeField" promptText="000000" styleClass="custom-field"
                                       style="-fx-font-size:22px; -fx-letter-spacing:8px; -fx-alignment:center;">
                            </TextField>
                            <Label fx:id="codeError" styleClass="error-label" visible="false"/>
                        </children>
                    </VBox>

                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="Nouveau mot de passe">
                                <font><Font name="System Bold" size="13.0"/></font>
                            </Label>
                            <PasswordField fx:id="newPasswordField" promptText="Min. 8 caractères" styleClass="custom-field">
                                <font><Font size="14.0"/></font>
                            </PasswordField>
                            <Label fx:id="newPasswordError" styleClass="error-label" visible="false"/>
                        </children>
                    </VBox>

                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="field-label" text="Confirmer le mot de passe">
                                <font><Font name="System Bold" size="13.0"/></font>
                            </Label>
                            <PasswordField fx:id="confirmPasswordField" promptText="Répétez le mot de passe" styleClass="custom-field">
                                <font><Font size="14.0"/></font>
                            </PasswordField>
                            <Label fx:id="confirmPasswordError" styleClass="error-label" visible="false"/>
                        </children>
                    </VBox>

                    <Button fx:id="resetButton" text="Réinitialiser le mot de passe"
                            onAction="#handleResetPassword"
                            prefHeight="45.0" prefWidth="350.0"
                            styleClass="signup-button">
                        <font><Font name="System Bold" size="14.0"/></font>
                        <VBox.margin><Insets top="8.0"/></VBox.margin>
                    </Button>

                </children>
            </VBox>

            <!-- Back to login -->
            <Button text="← Retour à la connexion" styleClass="nav-link"
                    onAction="#handleBackToLogin">
                <VBox.margin><Insets top="16.0"/></VBox.margin>
            </Button>

        </children>
    </VBox>

</AnchorPane>