<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" styleClass="root" stylesheets="@../../auth.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.auth.freelancer.StudentCardVerificationController">

    <!-- Left Panel - Branding -->
    <VBox alignment="CENTER" prefHeight="600.0" prefWidth="300.0" styleClass="left-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <Label styleClass="brand-title" text="UniEarn">
                <font>
                    <Font name="System Bold" size="48.0" />
                </font>
            </Label>
            <Label styleClass="brand-subtitle" text="Verify Your Status">
                <font>
                    <Font size="18.0" />
                </font>
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Label>
            <Label styleClass="brand-subtitle" text="Students only platform">
                <font>
                    <Font size="14.0" />
                </font>
                <VBox.margin>
                    <Insets top="5.0" />
                </VBox.margin>
            </Label>
        </children>
    </VBox>

    <!-- Right Panel - Verification Form -->
    <VBox alignment="TOP_CENTER" layoutX="300.0" prefHeight="600.0" prefWidth="550.0" styleClass="form-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
        </padding>
        <children>

            <!-- Progress Indicator -->
            <HBox alignment="CENTER" spacing="8.0">
                <children>
                    <VBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Label styleClass="progress-step-completed" text="1">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label styleClass="progress-label-completed" text="Account">
                                <font>
                                    <Font size="10.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>
                    <Label styleClass="progress-line-completed" text="━">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                    <VBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Label styleClass="progress-step-completed" text="2">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label styleClass="progress-label-completed" text="Profile">
                                <font>
                                    <Font size="10.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>
                    <Label styleClass="progress-line-completed" text="━">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                    <VBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Label styleClass="progress-step-active" text="3">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label styleClass="progress-label-active" text="Verification">
                                <font>
                                    <Font size="10.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>
                </children>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </HBox>

            <!-- ScrollPane for content -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="20.0">
                        <children>

                            <!-- Form Title -->
                            <Label styleClass="form-title" text="Student Verification">
                                <font>
                                    <Font name="System Bold" size="28.0" />
                                </font>
                            </Label>

                            <Label styleClass="form-subtitle" text="Prove you're a student">
                                <font>
                                    <Font size="13.0" />
                                </font>
                                <VBox.margin>
                                    <Insets bottom="5.0" />
                                </VBox.margin>
                            </Label>

                            <!-- Info Box -->
                            <VBox spacing="8.0" styleClass="info-box">
                                <children>
                                    <Label styleClass="info-title" text="Why do we need this?">
                                        <font>
                                            <Font name="System Bold" size="13.0" />
                                        </font>
                                    </Label>
                                    <Label styleClass="info-text" text="UniEarn is exclusively for student freelancers. We verify all freelancers to maintain platform integrity and protect clients." wrapText="true">
                                        <font>
                                            <Font size="12.0" />
                                        </font>
                                    </Label>
                                </children>
                                <padding>
                                    <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                                </padding>
                            </VBox>

                            <!-- Student Card Upload Section -->
                            <VBox spacing="15.0" styleClass="verification-box">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <children>
                                            <Label styleClass="verification-icon" text="🎓">
                                                <font>
                                                    <Font size="28.0" />
                                                </font>
                                            </Label>
                                            <VBox>
                                                <children>
                                                    <Label styleClass="field-label" text="Upload Student Card">
                                                        <font>
                                                            <Font name="System Bold" size="14.0" />
                                                        </font>
                                                    </Label>
                                                    <Label styleClass="helper-text" text="We'll verify your student status automatically">
                                                        <font>
                                                            <Font size="11.0" />
                                                        </font>
                                                    </Label>
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>

                                    <!-- Upload Instructions -->
                                    <VBox spacing="6.0">
                                        <children>
                                            <Label styleClass="field-label" text="📋 Requirements:">
                                                <font>
                                                    <Font name="System Bold" size="12.0" />
                                                </font>
                                            </Label>
                                            <Label styleClass="requirement-text" text="✓ Clear photo or scan of your student card">
                                                <font>
                                                    <Font size="11.0" />
                                                </font>
                                            </Label>
                                            <Label styleClass="requirement-text" text="✓ Card must be valid for current academic year">
                                                <font>
                                                    <Font size="11.0" />
                                                </font>
                                            </Label>
                                            <Label styleClass="requirement-text" text="✓ All text must be readable">
                                                <font>
                                                    <Font size="11.0" />
                                                </font>
                                            </Label>
                                            <Label styleClass="requirement-text" text="✓ Accepted formats: JPG, PNG, PDF (max 5MB)">
                                                <font>
                                                    <Font size="11.0" />
                                                </font>
                                            </Label>
                                        </children>
                                    </VBox>

                                    <Separator />

                                    <Button fx:id="uploadCardButton" onAction="#handleUploadCard" prefHeight="42.0" prefWidth="200.0" styleClass="upload-button" text="📤 Choose File">
                                        <font>
                                            <Font name="System Bold" size="13.0" />
                                        </font>
                                    </Button>

                                    <Label fx:id="cardFileLabel" styleClass="file-label" text="No file selected">
                                        <font>
                                            <Font size="12.0" />
                                        </font>
                                    </Label>

                                    <Label fx:id="verificationStatusLabel" styleClass="verification-status" visible="false" wrapText="true">
                                        <font>
                                            <Font name="System Bold" size="12.0" />
                                        </font>
                                    </Label>
                                </children>
                                <padding>
                                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                </padding>
                            </VBox>

                        </children>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Action Buttons -->
            <HBox spacing="15.0">
                <children>
                    <Button fx:id="backButton" onAction="#handleBack" prefHeight="40.0" prefWidth="160.0" styleClass="back-button" text="Back">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>
                    <Button fx:id="nextButton" onAction="#handleNext" prefHeight="40.0" prefWidth="230.0" styleClass="signup-button" text="Complete Registration">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>
                </children>
                <VBox.margin>
                    <Insets top="15.0" />
                </VBox.margin>
            </HBox>

        </children>
    </VBox>

</AnchorPane>
