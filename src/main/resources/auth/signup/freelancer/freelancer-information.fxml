<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" styleClass="root" stylesheets="@../../auth.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniearn.controller.auth.freelancer.FreelancerSignupController">

    <!-- Left Panel -->
    <VBox alignment="CENTER" prefHeight="600.0" prefWidth="300.0" styleClass="left-panel"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <Label styleClass="brand-title" text="UniEarn">
                <font><Font name="System Bold" size="48.0"/></font>
            </Label>
            <Label styleClass="brand-subtitle" text="Build your profile!">
                <font><Font size="18.0"/></font>
                <VBox.margin><Insets top="10.0"/></VBox.margin>
            </Label>
            <Label styleClass="brand-subtitle" text="Showcase your skills">
                <font><Font size="14.0"/></font>
                <VBox.margin><Insets top="5.0"/></VBox.margin>
            </Label>
        </children>
    </VBox>

    <!-- Right Panel -->
    <VBox alignment="TOP_CENTER" layoutX="300.0" prefHeight="600.0" prefWidth="550.0"
          styleClass="form-panel"
          AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding><Insets bottom="30.0" left="50.0" right="50.0" top="30.0"/></padding>
        <children>

            <!-- Progress Indicator -->
            <HBox alignment="CENTER" spacing="8.0">
                <VBox.margin><Insets bottom="20.0"/></VBox.margin>
                <children>
                    <VBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Label styleClass="progress-step-completed" text="1"><font><Font name="System Bold" size="14.0"/></font></Label>
                            <Label styleClass="progress-label-completed" text="Account"><font><Font size="10.0"/></font></Label>
                        </children>
                    </VBox>
                    <Label styleClass="progress-line-completed" text="━"><font><Font name="System Bold" size="14.0"/></font></Label>
                    <VBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Label styleClass="progress-step-active" text="2"><font><Font name="System Bold" size="14.0"/></font></Label>
                            <Label styleClass="progress-label-active" text="Profile"><font><Font size="10.0"/></font></Label>
                        </children>
                    </VBox>
                    <Label styleClass="progress-line" text="━"><font><Font name="System Bold" size="14.0"/></font></Label>
                    <VBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Label styleClass="progress-step-inactive" text="3"><font><Font name="System Bold" size="14.0"/></font></Label>
                            <Label styleClass="progress-label-inactive" text="Verification"><font><Font size="10.0"/></font></Label>
                        </children>
                    </VBox>
                    <Label styleClass="progress-line" text="━"><font><Font name="System Bold" size="14.0"/></font></Label>
                    <VBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Label styleClass="progress-step-inactive" text="4"><font><Font name="System Bold" size="14.0"/></font></Label>
                            <Label styleClass="progress-label-inactive" text="Portfolio"><font><Font size="10.0"/></font></Label>
                        </children>
                    </VBox>
                </children>
            </HBox>

            <!-- ScrollPane -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="18.0">
                        <children>

                            <Label styleClass="form-title" text="Freelancer Profile">
                                <font><Font name="System Bold" size="28.0"/></font>
                            </Label>
                            <Label styleClass="form-subtitle" text="Tell clients about your expertise">
                                <font><Font size="13.0"/></font>
                                <VBox.margin><Insets bottom="6.0"/></VBox.margin>
                            </Label>

                            <!-- Hourly Rate -->
                            <VBox spacing="8.0">
                                <children>
                                    <Label styleClass="field-label" text="Hourly Rate"><font><Font name="System Bold" size="13.0"/></font></Label>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <TextField fx:id="hourlyRateField" prefWidth="250.0" promptText="0.00" styleClass="custom-field">
                                                <font><Font size="14.0"/></font>
                                            </TextField>
                                            <Label styleClass="helper-text" text="TND/hour"><font><Font size="13.0"/></font></Label>
                                        </children>
                                    </HBox>
                                    <Label fx:id="hourlyRateError" styleClass="error-label" visible="false" managed="false"/>
                                </children>
                            </VBox>

                            <!-- Skills -->
                            <VBox spacing="8.0">
                                <children>
                                    <Label styleClass="field-label" text="Skills"><font><Font name="System Bold" size="13.0"/></font></Label>
                                    <FlowPane fx:id="skillsChipsPane" hgap="8.0" vgap="8.0" minHeight="45.0"
                                              style="-fx-background-color:#f8f9fa;-fx-border-color:#dee2e6;-fx-border-radius:8px;-fx-background-radius:8px;-fx-border-width:1.5px;-fx-padding:8px;"/>
                                    <TextField fx:id="skillSearchField" promptText="🔍 Search and add skills..." styleClass="custom-field">
                                        <font><Font size="14.0"/></font>
                                    </TextField>
                                    <ListView fx:id="skillSuggestionsView" prefHeight="150.0" visible="false" managed="false"
                                              style="-fx-background-color:white;-fx-border-color:#1976d2;-fx-border-radius:8px;-fx-border-width:1.5px;"/>
                                    <Label styleClass="helper-text" text="Search and select up to 20 skills"><font><Font size="12.0"/></font></Label>
                                    <Label fx:id="skillsError" styleClass="error-label" visible="false" managed="false"/>
                                </children>
                            </VBox>

                            <!-- ══ CV Upload Section ══ -->
                            <VBox spacing="0.0"
                                  style="-fx-background-color:#f8faff;-fx-border-color:#c7d7f5;-fx-border-radius:12px;-fx-background-radius:12px;-fx-border-width:1.5px;">
                                <padding><Insets top="16.0" bottom="16.0" left="16.0" right="16.0"/></padding>
                                <children>

                                    <!-- Section header -->
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <VBox.margin><Insets bottom="10.0"/></VBox.margin>
                                        <children>
                                            <VBox spacing="2.0">
                                                <children>
                                                    <Label text="Upload Your CV" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1e293b;"/>
                                                    <Label text="We'll auto-generate your bio using AI" style="-fx-font-size:11px;-fx-text-fill:#64748b;"/>
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>

                                    <!-- Upload row -->
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <VBox.margin><Insets bottom="8.0"/></VBox.margin>
                                        <children>
                                            <Button fx:id="uploadCvButton" onAction="#handleUploadCv"
                                                    prefHeight="38.0" prefWidth="145.0"
                                                    styleClass="upload-button" text="📄 Choose CV">
                                                <font><Font name="System Bold" size="12.0"/></font>
                                            </Button>
                                            <Label fx:id="cvFileLabel"
                                                   style="-fx-font-size:12px;-fx-text-fill:#64748b;-fx-font-style:italic;"
                                                   text="No file selected"/>
                                        </children>
                                    </HBox>

                                    <!-- Format hint -->
                                    <Label text="✓  Only accepted format is PDF · max 5 MB"
                                           style="-fx-font-size:11px;-fx-text-fill:#94a3b8;">
                                        <VBox.margin><Insets bottom="12.0"/></VBox.margin>
                                    </Label>

                                    <Separator><VBox.margin><Insets bottom="12.0"/></VBox.margin></Separator>

                                    <!-- AI Generate row -->
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <children>
                                            <Button fx:id="generateBioButton" onAction="#generateBioWithAi"
                                                    prefHeight="36.0" prefWidth="195.0"
                                                    style="-fx-background-color:#7c3aed;-fx-text-fill:white;-fx-background-radius:8px;-fx-cursor:hand;-fx-effect:dropshadow(gaussian,rgba(124,58,237,0.3),8,0,0,2);"
                                                    text="✨  Generate Bio with AI">
                                                <font><Font name="System Bold" size="12.0"/></font>
                                            </Button>
                                            <Label fx:id="aiStatusLabel"
                                                   visible="false" managed="false"
                                                   style="-fx-font-size:11px;-fx-text-fill:#16a34a;-fx-font-weight:bold;"
                                                   text="" wrapText="true"/>
                                        </children>
                                    </HBox>

                                    <!--
                                        cvError: managed=true ALWAYS so layout never jumps.
                                        Controller only toggles visible, never managed.
                                    -->
                                    <Label fx:id="cvError" styleClass="error-label"
                                           visible="false" managed="true"
                                           wrapText="true" maxWidth="Infinity" text="">
                                        <VBox.margin><Insets top="8.0"/></VBox.margin>
                                    </Label>

                                </children>
                            </VBox>

                            <!-- ══ Professional Bio Section ══ -->
                            <VBox spacing="0.0"
                                  style="-fx-background-color:#ffffff;-fx-border-color:#e2e8f0;-fx-border-radius:12px;-fx-background-radius:12px;-fx-border-width:1.5px;-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.04),8,0,0,2);">
                                <padding><Insets top="16.0" bottom="16.0" left="16.0" right="16.0"/></padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <VBox.margin><Insets bottom="12.0"/></VBox.margin>
                                        <children>
                                            <FontIcon fx:id="bioSpinnerLabel"
                                                      iconLiteral="fas-spinner"
                                                      iconSize="14"
                                                      iconColor="#7c3aed"
                                                      visible="false" managed="false"/>
                                            <Label text="Professional Bio" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1e293b;"/>
                                        </children>
                                    </HBox>

                                    <TextArea fx:id="bioField"
                                              prefHeight="160.0" prefRowCount="7"
                                              promptText="Upload your CV above to auto-generate, or write manually…"
                                              wrapText="true"
                                              style="-fx-background-color:#f8fafc;-fx-border-color:#e2e8f0;-fx-border-radius:8px;-fx-background-radius:8px;-fx-border-width:1.5px;-fx-padding:14px 16px;-fx-font-size:13px;-fx-text-fill:#334155;">
                                        <font><Font size="13.0"/></font>
                                        <VBox.margin><Insets bottom="10.0"/></VBox.margin>
                                    </TextArea>

                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                        <children>
                                            <Label text="ℹ" style="-fx-font-size:11px;-fx-text-fill:#94a3b8;"/>
                                            <Label text="Between 50 and 500 characters · AI-generated bio is fully editable"
                                                   style="-fx-font-size:11px;-fx-text-fill:#94a3b8;"/>
                                        </children>
                                    </HBox>

                                    <Label fx:id="bioError" styleClass="error-label" visible="false" managed="false">
                                        <VBox.margin><Insets top="4.0"/></VBox.margin>
                                    </Label>

                                </children>
                            </VBox>

                            <!-- Experience Level -->
                            <VBox spacing="8.0">
                                <children>
                                    <Label styleClass="field-label" text="Experience Level">
                                        <font><Font name="System Bold" size="13.0"/></font>
                                    </Label>
                                    <ComboBox fx:id="experienceComboBox" prefWidth="450.0"
                                              promptText="Select your experience level" styleClass="custom-combo"/>
                                    <Label fx:id="experienceError" styleClass="error-label" visible="false" managed="false"/>
                                </children>
                            </VBox>

                        </children>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Action Buttons -->
            <HBox spacing="15.0">
                <VBox.margin><Insets top="15.0"/></VBox.margin>
                <children>
                    <Button fx:id="backButton" onAction="#handleBack" prefHeight="40.0" prefWidth="160.0"
                            styleClass="back-button" text="Back">
                        <font><Font name="System Bold" size="14.0"/></font>
                    </Button>
                    <Button fx:id="nextButton" onAction="#handleNext" prefHeight="40.0" prefWidth="230.0"
                            styleClass="signup-button" text="Next">
                        <font><Font name="System Bold" size="14.0"/></font>
                    </Button>
                </children>
            </HBox>

        </children>
    </VBox>

</AnchorPane>
