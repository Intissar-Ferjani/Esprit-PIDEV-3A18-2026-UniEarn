<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="750.0" styleClass="root" stylesheets="@../auth.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.auth.user.SignupController">

    <!-- Left Panel - Branding -->
    <VBox alignment="CENTER" prefHeight="600.0" prefWidth="300.0" styleClass="left-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <Label styleClass="brand-title" text="UniEarn">
                <font>
                    <Font name="System Bold" size="48.0" />
                </font>
            </Label>
            <Label styleClass="brand-subtitle" text="Join our community today">
                <font>
                    <Font size="18.0" />
                </font>
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Label>
        </children>
    </VBox>

    <!-- Right Panel - Signup Form -->
    <VBox alignment="CENTER" layoutX="300.0" prefHeight="600.0" prefWidth="450.0" styleClass="form-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
        </padding>
        <children>
            <ImageView fitHeight="80.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../images/logoUniEarn.png" />
                </image>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </ImageView>

            <!-- Form Title -->
            <Label styleClass="form-title" text="Create Account">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="5.0" />
                </VBox.margin>
            </Label>

            <Label styleClass="form-subtitle" text="Sign up to get started">
                <font>
                    <Font size="13.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="25.0" />
                </VBox.margin>
            </Label>

            <!-- Name Field -->
            <VBox spacing="6.0">
                <children>
                    <Label styleClass="field-label" text="Full Name">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Label>
                    <TextField fx:id="nameField" promptText="Enter your full name" styleClass="custom-field">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </TextField>
                    <Label fx:id="nameError" styleClass="error-label" visible="false" />
                </children>
                <VBox.margin>
                    <Insets bottom="12.0" />
                </VBox.margin>
            </VBox>

            <!-- Email Field -->
            <VBox spacing="6.0">
                <children>
                    <Label styleClass="field-label" text="Email Address">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Label>
                    <TextField fx:id="emailField" promptText="Enter your email" styleClass="custom-field">
                        <font>
                            <Font size="13.0" />
                        </font>
                    </TextField>
                    <Label fx:id="emailError" styleClass="error-label" visible="false" />
                </children>
                <VBox.margin>
                    <Insets bottom="12.0" />
                </VBox.margin>
            </VBox>

            <!-- Password Field with Show/Hide Button -->
            <VBox spacing="6.0">
                <children>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <children>
                            <Label styleClass="field-label" text="Password" HBox.hgrow="ALWAYS">
                                <font>
                                    <Font name="System Bold" size="12.0" />
                                </font>
                            </Label>
                            <!-- Generate Password Button -->
                            <Button fx:id="generatePasswordButton" onAction="#handleGeneratePassword"
                                    text="🎲 Generate"
                                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 11px; -fx-padding: 4 10; -fx-cursor: hand; -fx-background-radius: 4;">
                                <tooltip>
                                    <Tooltip text="Generate a secure random password" />
                                </tooltip>
                            </Button>
                        </children>
                    </HBox>
                    <HBox spacing="4.0">
                        <children>
                            <!-- Hidden Password Field (shown by default) -->
                            <PasswordField fx:id="passwordField" promptText="Create a password" styleClass="custom-field" HBox.hgrow="ALWAYS">
                                <font>
                                    <Font size="13.0" />
                                </font>
                            </PasswordField>
                            <!-- Visible Password Field (hidden by default) -->
                            <TextField fx:id="passwordFieldVisible" promptText="Create a password" styleClass="custom-field" HBox.hgrow="ALWAYS" visible="false" managed="false">
                                <font>
                                    <Font size="13.0" />
                                </font>
                            </TextField>
                            <!-- Show/Hide Toggle Button -->
                            <Button fx:id="togglePasswordButton" onAction="#handleTogglePassword" text="👁"
                                    style="-fx-background-color: #f0f0f0; -fx-font-size: 16px; -fx-padding: 8 12; -fx-cursor: hand; -fx-background-radius: 4;">
                                <tooltip>
                                    <Tooltip text="Show/Hide password" />
                                </tooltip>
                            </Button>
                        </children>
                    </HBox>
                    <Label fx:id="passwordError" styleClass="error-label" visible="false" />
                </children>
                <VBox.margin>
                    <Insets bottom="12.0" />
                </VBox.margin>
            </VBox>

            <!-- Confirm Password Field with Show/Hide Button -->
            <VBox spacing="6.0">
                <children>
                    <Label styleClass="field-label" text="Confirm Password">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Label>
                    <HBox spacing="4.0">
                        <children>
                            <!-- Hidden Confirm Password Field (shown by default) -->
                            <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password" styleClass="custom-field" HBox.hgrow="ALWAYS">
                                <font>
                                    <Font size="13.0" />
                                </font>
                            </PasswordField>
                            <!-- Visible Confirm Password Field (hidden by default) -->
                            <TextField fx:id="confirmPasswordFieldVisible" promptText="Re-enter your password" styleClass="custom-field" HBox.hgrow="ALWAYS" visible="false" managed="false">
                                <font>
                                    <Font size="13.0" />
                                </font>
                            </TextField>
                            <!-- Show/Hide Toggle Button -->
                            <Button fx:id="toggleConfirmPasswordButton" onAction="#handleToggleConfirmPassword" text="👁"
                                    style="-fx-background-color: #f0f0f0; -fx-font-size: 16px; -fx-padding: 8 12; -fx-cursor: hand; -fx-background-radius: 4;">
                                <tooltip>
                                    <Tooltip text="Show/Hide confirm password" />
                                </tooltip>
                            </Button>
                        </children>
                    </HBox>
                    <Label fx:id="confirmPasswordError" styleClass="error-label" visible="false" />
                </children>
                <VBox.margin>
                    <Insets bottom="12.0" />
                </VBox.margin>
            </VBox>

            <!-- Role Selection -->
            <VBox spacing="6.0">
                <children>
                    <Label styleClass="field-label" text="I am a">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Label>
                    <ComboBox fx:id="roleComboBox" prefWidth="370.0" promptText="Select your role" styleClass="custom-combo" />
                    <Label fx:id="roleError" styleClass="error-label" visible="false" />
                </children>
            </VBox>

            <!-- Terms Checkbox -->
            <HBox spacing="8.0">
                <children>
                    <CheckBox fx:id="termsCheckbox" />
                    <Label styleClass="terms-label" text="I agree to the Terms of Service and Privacy Policy" wrapText="true">
                        <font>
                            <Font size="12.0" />
                        </font>
                    </Label>
                </children>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </HBox>
            <Label fx:id="termsError" styleClass="error-label" visible="false" />

            <!-- Sign Up Button -->
            <Button fx:id="signupButton" maxWidth="Infinity" onAction="#handleSignup" prefHeight="42.0" styleClass="signup-button" text="Sign Up">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="15.0" />
                </VBox.margin>
            </Button>

            <!-- Login Link -->
            <HBox alignment="CENTER" spacing="5.0">
                <children>
                    <Label styleClass="login-label" text="Already have an account?">
                        <font>
                            <Font size="12.0" />
                        </font>
                    </Label>
                    <Hyperlink fx:id="loginLink" onAction="#handleLoginRedirect" styleClass="login-link" text="Log In">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Hyperlink>
                </children>
            </HBox>

        </children>
    </VBox>

</AnchorPane>
