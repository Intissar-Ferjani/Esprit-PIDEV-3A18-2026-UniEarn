<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="750.0" styleClass="root" stylesheets="@../../auth.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.auth.client.ClientSignupController">

    <!-- Left Panel - Branding -->
    <VBox alignment="CENTER" prefHeight="600.0" prefWidth="300.0" styleClass="left-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <Label styleClass="brand-title" text="UniEarn">
                <font>
                    <Font name="System Bold" size="48.0" />
                </font>
            </Label>
            <Label styleClass="brand-subtitle" text="Almost there!">
                <font>
                    <Font size="18.0" />
                </font>
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </Label>
            <Label styleClass="brand-subtitle" text="Complete your client profile">
                <font>
                    <Font size="14.0" />
                </font>
                <VBox.margin>
                    <Insets top="5.0" />
                </VBox.margin>
            </Label>
        </children>
    </VBox>

    <!-- Right Panel - Client Profile Form -->
    <VBox alignment="CENTER" layoutX="300.0" prefHeight="600.0" prefWidth="450.0" styleClass="form-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
        </padding>
        <children>

            <!-- Progress Indicator -->
            <HBox alignment="CENTER" spacing="10.0">
                <children>
                    <VBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Label styleClass="progress-step-completed" text="1">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label styleClass="progress-label-completed" text="Account">
                                <font>
                                    <Font size="11.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>
                    <Label styleClass="progress-line-completed" text="━━━">
                        <font>
                            <Font name="System Bold" size="16.0" />
                        </font>
                    </Label>
                    <VBox alignment="CENTER" spacing="5.0">
                        <children>
                            <Label styleClass="progress-step-active" text="2">
                                <font>
                                    <Font name="System Bold" size="14.0" />
                                </font>
                            </Label>
                            <Label styleClass="progress-label-active" text="Profile">
                                <font>
                                    <Font size="11.0" />
                                </font>
                            </Label>
                        </children>
                    </VBox>
                </children>
                <VBox.margin>
                    <Insets bottom="30.0" />
                </VBox.margin>
            </HBox>

            <!-- Form Title -->
            <Label styleClass="form-title" text="Client Profile">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="10.0" />
                </VBox.margin>
            </Label>

            <Label styleClass="form-subtitle" text="Tell us more about yourself">
                <font>
                    <Font size="14.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="40.0" />
                </VBox.margin>
            </Label>

            <!-- Budget/Amount Field -->
            <VBox spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Initial Budget (Optional)">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <children>
                            <Label styleClass="currency-symbol" text="TND">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                            </Label>
                            <TextField fx:id="amountField" promptText="0.00" styleClass="custom-field" HBox.hgrow="ALWAYS">
                                <font>
                                    <Font size="14.0" />
                                </font>
                            </TextField>
                        </children>
                    </HBox>
                    <Label styleClass="helper-text" text="Enter the budget you'd like to allocate for projects">
                        <font>
                            <Font size="12.0" />
                        </font>
                    </Label>
                    <Label fx:id="amountError" styleClass="error-label" visible="false" />
                </children>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </VBox>

            <!-- Company/Organization Field -->
            <VBox spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Company / Organization">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <TextField fx:id="companyField" promptText="Enter your company name" styleClass="custom-field">
                        <font>
                            <Font size="14.0" />
                        </font>
                    </TextField>
                    <Label fx:id="companyError" styleClass="error-label" visible="false" />
                </children>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </VBox>

            <!-- Industry/Category -->
            <VBox spacing="8.0">
                <children>
                    <Label styleClass="field-label" text="Industry / Category">
                        <font>
                            <Font name="System Bold" size="13.0" />
                        </font>
                    </Label>
                    <ComboBox fx:id="industryComboBox" prefWidth="330.0" promptText="Select your industry" styleClass="custom-combo" />
                    <Label fx:id="industryError" styleClass="error-label" visible="false" />
                </children>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </VBox>

            <!-- Action Buttons -->
            <HBox spacing="15.0">
                <children>
                    <Button fx:id="backButton" onAction="#handleBack" prefHeight="45.0" prefWidth="150.0" styleClass="back-button" text="Back">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>
                    <Button fx:id="completeButton" onAction="#handleComplete" prefHeight="45.0" prefWidth="180.0" styleClass="signup-button" text="Complete Setup">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>
                </children>
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
            </HBox>

        </children>
    </VBox>

</AnchorPane>
