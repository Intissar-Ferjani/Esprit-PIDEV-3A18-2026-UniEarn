<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.ContratDialogController">
    <top>
        <VBox styleClass="header" style="-fx-background-color: #1E56DB; -fx-padding: 20;">
            <Label text="Ajouter un Contrat" styleClass="title-label" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
            <Label text="Remplissez les détails du contrat" styleClass="subtitle-label" style="-fx-text-fill: #EEEEEE; -fx-font-size: 12; -fx-padding: 5 0 0 0;" />
        </VBox>
    </top>

    <center>
        <VBox styleClass="form-container" style="-fx-padding: 30; -fx-spacing: 20; -fx-background-color: #F5F5F5;">

            <!-- Ligne 1: Client et Projet -->
            <HBox spacing="20">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="ID Client *" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12;" />
                    <TextField fx:id="clientIDField" promptText="Ex: 1" styleClass="text-field-custom"
                               style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-font-size: 12;" />
                </VBox>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="ID Projet *" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12;" />
                    <TextField fx:id="projectIDField" promptText="Ex: 1" styleClass="text-field-custom"
                               style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-font-size: 12;" />
                </VBox>
            </HBox>

            <!-- Ligne 2: Montant et Paiement -->
            <HBox spacing="20">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Montant (DA) *" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12;" />
                    <TextField fx:id="amountField" promptText="Ex: 50000" styleClass="text-field-custom"
                               style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-font-size: 12;" />
                </VBox>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="ID Paiement (Optionnel)" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12;" />
                    <TextField fx:id="paymentIDField" promptText="Ex: 1" styleClass="text-field-custom"
                               style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-font-size: 12;" />
                </VBox>
            </HBox>

            <!-- Ligne 3: Dates -->
            <HBox spacing="20">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Date de Début *" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12;" />
                    <DatePicker fx:id="startDatePicker" styleClass="date-picker-custom"
                                style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-font-size: 12;" />
                </VBox>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Date de Fin *" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12;" />
                    <DatePicker fx:id="endDatePicker" styleClass="date-picker-custom"
                                style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-font-size: 12;" />
                </VBox>
            </HBox>

            <!-- Ligne 4: Statut -->
            <VBox spacing="8">
                <Label text="Statut" style="-fx-font-weight: bold; -fx-text-fill: #333333; -fx-font-size: 12;" />
                <ComboBox fx:id="statusComboBox" promptText="Sélectionner un statut" styleClass="combo-box-custom"
                          style="-fx-padding: 10; -fx-border-color: #CCCCCC; -fx-border-radius: 5; -fx-font-size: 12;">
                    <!-- Les items seront ajoutés au contrôleur -->
                </ComboBox>
            </VBox>

            <!-- Ligne 5: Message d'erreur -->
            <Label fx:id="errorLabel" text="" style="-fx-text-fill: #FF6B6B; -fx-font-size: 12; -fx-padding: 10;" />

        </VBox>
    </center>

    <bottom>
        <HBox spacing="15" style="-fx-padding: 20; -fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-border-width: 1 0 0 0;">
            <Button fx:id="addButton" text="✓ Ajouter" styleClass="btn-primary"
                    style="-fx-padding: 12 30; -fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-border-radius: 5; -fx-cursor: hand;" />

            <Button fx:id="resetButton" text="↻ Réinitialiser" styleClass="btn-secondary"
                    style="-fx-padding: 12 30; -fx-background-color: #1E56DB; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-border-radius: 5; -fx-cursor: hand;" />

            <Button fx:id="cancelButton" text="✕ Fermer" styleClass="btn-danger"
                    style="-fx-padding: 12 30; -fx-background-color: #666666; -fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold; -fx-border-radius: 5; -fx-cursor: hand;" />

            <HBox HBox.hgrow="ALWAYS" />

            <Label fx:id="statusLabel" text="En attente..." style="-fx-text-fill: #666666; -fx-font-size: 11;" />
        </HBox>
    </bottom>
</BorderPane>

