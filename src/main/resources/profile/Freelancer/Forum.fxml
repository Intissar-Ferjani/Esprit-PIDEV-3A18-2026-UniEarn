<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="uniearn.controller.FreelancerForumController"
    prefHeight="600.0" prefWidth="900.0"
    style="-fx-background-color: #f0f7f4;">

    <!-- Top Navigation Bar — Green -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
            style="-fx-background-color: #1a7a4c; -fx-padding: 15;">
            <Label text="Freelancer Forum" textFill="white">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Message Icon Button -->
            <Button fx:id="messageButton" onAction="#openMessages"
                style="-fx-background-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="💬" style="-fx-font-size: 28px;" />
                        <Label text="Messages" style="-fx-text-fill: white; -fx-font-size: 10px;" />
                    </VBox>
                </graphic>
                <tooltip>
                    <Tooltip text="Go to Messages" />
                </tooltip>
            </Button>

            <!-- Notification Icon Button -->
            <Button fx:id="notificationButton" onAction="#openNotifications"
                style="-fx-background-color: transparent; -fx-cursor: hand;">
                <graphic>
                    <VBox alignment="CENTER" spacing="2">
                        <StackPane>
                            <Label text="🔔" style="-fx-font-size: 28px;" />
                            <Label fx:id="notificationBadge" text="0"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                          -fx-background-radius: 10; -fx-padding: 2 6 2 6;
                                          -fx-font-size: 11px; -fx-font-weight: bold;"
                                translateX="12" translateY="-10" />
                        </StackPane>
                        <Label text="Notifications"
                            style="-fx-text-fill: white; -fx-font-size: 10px;" />
                    </VBox>
                </graphic>
                <tooltip>
                    <Tooltip text="Go to Notifications" />
                </tooltip>
            </Button>
        </HBox>
    </top>

    <!-- Center Content -->
    <center>
        <VBox spacing="20" style="-fx-padding: 25;">

            <!-- Create New Post Section -->
            <VBox spacing="12"
                style="-fx-background-color: white; -fx-padding: 20;
                                      -fx-border-color: #c8e6c9; -fx-border-radius: 8;
                                      -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label text="Create New Post"
                    style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a7a4c;" />

                <TextField fx:id="postTitleField" promptText="Post Title"
                    style="-fx-font-size: 14px; -fx-padding: 10; -fx-border-color: #a5d6a7; -fx-border-radius: 5; -fx-background-radius: 5;" />

                <TextArea fx:id="postContentArea"
                    promptText="Share your thoughts, questions, or experiences..."
                    prefRowCount="4" wrapText="true"
                    style="-fx-font-size: 14px; -fx-border-color: #a5d6a7; -fx-border-radius: 5; -fx-background-radius: 5;" />

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Cancel" onAction="#clearPost"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                                   -fx-padding: 10 25 10 25; -fx-font-size: 14px; -fx-cursor: hand;
                                   -fx-background-radius: 5;" />
                    <Button text="Post" onAction="#createPost"
                        style="-fx-background-color: #1a7a4c; -fx-text-fill: white;
                                   -fx-padding: 10 30 10 30; -fx-font-weight: bold;
                                   -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 5;" />
                </HBox>
            </VBox>

            <!-- Posts Feed -->
            <Label text="Recent Posts"
                style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a7a4c;" />

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox fx:id="postsContainer" spacing="15" style="-fx-padding: 5;" />
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>