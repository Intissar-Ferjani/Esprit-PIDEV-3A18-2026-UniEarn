<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox spacing="25.0" style="-fx-background-color: #f0f2f5;" stylesheets="@../../profile/profile.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.profile.freelancer.FreelancerPaymentMethodsController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <children>
            <FontIcon iconLiteral="fas-university" iconSize="24" iconColor="#2d3748" />
            <Label style="-fx-text-fill: #1a202c; -fx-font-weight: bold; -fx-font-size: 20px;" text="Paramètres Bancaires (Escrow)" />
        </children>
    </HBox>

    <!-- Success Alert Box (Initially hidden) -->
    <VBox fx:id="successAlert" managed="false" visible="false" spacing="5.0" style="-fx-background-color: #e6f4ea; -fx-border-color: #34a853; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15;">
        <children>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <children>
                    <FontIcon iconLiteral="fas-check-circle" iconSize="16" iconColor="#2e7d32" />
                    <Label style="-fx-text-fill: #2e7d32; -fx-font-weight: bold;" text="Vos coordonnées bancaires ont été sauvegardées. Elles documenteront le système Escrow pour vos futurs paiements. 💰" wrapText="true" />
                </children>
            </HBox>
        </children>
    </VBox>

    <!-- Main Card -->
    <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2); -fx-padding: 30;">
        <children>
            <!-- Card Title -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <children>
                    <FontIcon iconLiteral="fas-landmark" iconSize="18" iconColor="#4a5568" />
                    <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #2d3748;" text="Coordonnées de Réception des Fonds" />
                </children>
            </HBox>

            <Separator />

            <!-- Info Box (Blue) -->
            <HBox spacing="15.0" style="-fx-background-color: #e8f0fe; -fx-border-color: #1a73e8; -fx-border-radius: 5; -fx-padding: 15;">
                <children>
                    <FontIcon iconLiteral="fas-info-circle" iconSize="16" iconColor="#1a73e8" />
                    <VBox spacing="2.0">
                        <children>
                            <Label style="-fx-text-fill: #1a73e8; -fx-font-weight: bold;" text="Sécurité Escrow :" />
                            <Label style="-fx-text-fill: #1a73e8;" text="Pour que nous puissions vous transférer l'argent une fois que le client aura validé votre travail, vous devez renseigner vos informations bancaires de réception." wrapText="true" />
                        </children>
                    </VBox>
                </children>
            </HBox>

            <!-- Form -->
            <VBox spacing="20.0">
                <children>
                    <!-- IBAN Field -->
                    <VBox spacing="8.0">
                        <children>
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" text="Numéro de compte (IBAN/RIB)" />
                            <TextField fx:id="ibanField" prefHeight="45.0" promptText="Ex: TN5900000000000000000000" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-color: #f8fafc; -fx-padding: 0 15;" />
                        </children>
                    </VBox>

                    <!-- SWIFT Field -->
                    <VBox spacing="8.0">
                        <children>
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" text="Code SWIFT/BIC (Optionnel)" />
                            <TextField fx:id="swiftCodeField" prefHeight="45.0" promptText="Ex: BIATNTT" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-color: #f8fafc; -fx-padding: 0 15;" />
                        </children>
                    </VBox>

                    <Region prefHeight="10.0" />

                    <!-- Save Button -->
                    <Button fx:id="saveButton" maxWidth="1.7976931348623157E308" prefHeight="50.0" style="-fx-background-color: #00897b; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="💾 Enregistrer les coordonnées">
                        <graphic>
                            <FontIcon iconLiteral="fas-save" iconColor="white" iconSize="16" />
                        </graphic>
                    </Button>

                    <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-text-fill: #a0aec0; -fx-font-size: 11px;" text="Aucun frais ne sera prélevé sur votre compte. C'est uniquement pour vous envoyer de l'argent !" />
                </children>
            </VBox>
        </children>
    </VBox>

    <!-- Hidden Message Label for errors -->
    <Label fx:id="messageLabel" visible="false" managed="false" />

</VBox>
