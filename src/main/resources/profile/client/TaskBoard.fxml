<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root"
            stylesheets="@../../profile/profile.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniearn.controller.projet.TaskBoardController">

    <!-- ═══════════════════════════════════════════════════════ TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" styleClass="top-bar">
            <padding><Insets left="30.0" right="30.0"/></padding>
            <children>
                <Button onAction="#handleBackToProfile" styleClass="btn-secondary" text="← Retour">
                    <font><Font size="13.0"/></font>
                </Button>
                <Region HBox.hgrow="ALWAYS"/>
                <ImageView fitHeight="55.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../images/UniEarn_full_logo.png"/></image>
                </ImageView>
            </children>
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════════════════ SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" prefWidth="250.0">
            <children>
                <!-- Navigation Menu -->
                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="20.0" left="15.0" right="15.0" bottom="15.0" />
                    </padding>
                    <children>
                        <Button text="🏠 Dashboard" styleClass="nav-button" prefWidth="220.0" prefHeight="40.0" onAction="#handleBackToProfile">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button text="📋 Projets disponibles" styleClass="nav-button" prefWidth="220.0" prefHeight="40.0" onAction="#handleFreelancerProjects">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button text="📝 Mes contrats" styleClass="nav-button" prefWidth="220.0" prefHeight="40.0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button text="☑ Mes tâches" styleClass="nav-button, active" prefWidth="220.0" prefHeight="40.0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button text="💼 Portfolio" styleClass="nav-button" prefWidth="220.0" prefHeight="40.0" onAction="#handleViewPortfolio">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button text="💬 Messages" styleClass="nav-button" prefWidth="220.0" prefHeight="40.0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button text="💳 Paiements" styleClass="nav-button" prefWidth="220.0" prefHeight="40.0">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Region VBox.vgrow="ALWAYS" />

                        <Separator />

                        <Button text="⚙ Settings" styleClass="nav-button" prefWidth="220.0" prefHeight="40.0" >
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button text="🚪 Logout" styleClass="nav-button, logout" prefWidth="220.0" prefHeight="40.0" onAction="#handleLogout">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>
    <!-- ═══════════════════════════════════════════════════ MAIN CONTENT -->
    <center>
        <VBox style="-fx-background-color: #f5f7fa;" VBox.vgrow="ALWAYS">
            <padding><Insets bottom="20.0" left="30.0" right="30.0" top="20.0"/></padding>
            <children>
                <!-- Dashboard Header -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="☑ Task Board" style="-fx-text-fill: #14171a; -fx-font-weight: bold;">
                            <font><Font size="26.0"/></font>
                        </Label>
                        
                        <Region HBox.hgrow="ALWAYS"/>
                        
                        <!-- Toggle Switch -->
                        <ToggleButton fx:id="viewToggle" text="View: By Status" onAction="#handleViewToggle" style="-fx-background-color: white; -fx-text-fill: #14171a; -fx-border-color: #e1e8ed; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;">
                            <font><Font size="13.0"/></font>
                        </ToggleButton>
                        
                        <!-- Search Field -->
                        <TextField fx:id="searchField" promptText="🔍 Rechercher une tâche..." prefWidth="250.0"
                                   style="-fx-background-color: white; -fx-border-color: #e1e8ed; -fx-text-fill: #14171a; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13;">
                        </TextField>

                        <!-- New Task Button -->
                        <Button onAction="#handleNewTask" text="➕ New Task" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 15; -fx-cursor: hand;">
                            <font><Font size="13.0"/></font>
                        </Button>
                    </children>
                </HBox>

                <Separator style="-fx-background-color: #2c3e50; -fx-border-width: 0;">
                    <VBox.margin><Insets top="15.0" bottom="20.0"/></VBox.margin>
                </Separator>

                <!-- Board Container -->
                <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: #f5f7fa; -fx-background-color: #f5f7fa; -fx-border-color: transparent;">
                    <content>
                        <HBox fx:id="boardContainer" spacing="25.0" style="-fx-background-color: #f5f7fa;">
                            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>
                            <!-- Columns will be injected here dynamically -->
                        </HBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>

</BorderPane>
