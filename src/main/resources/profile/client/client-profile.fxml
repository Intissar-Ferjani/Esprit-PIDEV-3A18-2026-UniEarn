<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.*?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root" stylesheets="@../../profile/profile.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.profile.client.ClientProfileController">

    <!-- ══ Top Navigation Bar ══════════════════════════════════════════ -->
    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" onMouseDragged="#handleMouseDragged" onMousePressed="#handleMousePressed" prefHeight="68.0" spacing="20.0" styleClass="top-bar">
            <padding><Insets left="30.0" right="15.0" /></padding>
            <children>
                <!-- Logo on the left -->
                <ImageView fitHeight="55.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../images/UniEarn_full_logo.png" /></image>
                </ImageView>
                
                <Region HBox.hgrow="ALWAYS" />
                
                <!-- Window Controls on the right -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="window-controls">
                    <children>
                        <Button onAction="#handleMinimize" styleClass="btn-window-control, btn-minimize">
                            <graphic><FontIcon iconLiteral="fas-minus" iconSize="12" /></graphic>
                        </Button>
                        <Button fx:id="btnMaximize" onAction="#handleMaximize" styleClass="btn-window-control, btn-maximize">
                            <graphic><FontIcon iconLiteral="fas-expand-arrows-alt" iconSize="12" /></graphic>
                        </Button>
                        <Button onAction="#handleClose" styleClass="btn-window-control, btn-close">
                            <graphic><FontIcon iconLiteral="fas-times" iconSize="12" /></graphic>
                        </Button>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <!-- ══ Left Sidebar ════════════════════════════════════════════════ -->
    <left>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED">
            <content>
                <VBox prefWidth="248.0" styleClass="sidebar">
                    <children>
                        <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                            <padding><Insets bottom="15.0" left="14.0" right="14.0" top="22.0" /></padding>
                            <children>
        
                                <Button onAction="#handleShowDashboard" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button, active">
                                    <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                        <FontIcon iconLiteral="fas-home" iconSize="15" />
                                        <Label style="-fx-font-size: 14px;" text="Dashboard" />
                                    </children></HBox></graphic>
                                </Button>
        
                                <Button onAction="#handleBrowseFreelancers" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button">
                                    <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                        <FontIcon iconLiteral="fas-users" iconSize="15" />
                                        <Label style="-fx-font-size: 14px;" text="Browse Freelancers" />
                                    </children></HBox></graphic>
                                </Button>
        
                                <Button onAction="#handleMesProjets" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button">
                                    <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                        <FontIcon iconLiteral="fas-clipboard-list" iconSize="15" />
                                        <Label style="-fx-font-size: 14px;" text="Mes projets" />
                                    </children></HBox></graphic>
                                </Button>
        
                                <Button onAction="#handleMesContrats" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button">
                                    <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                        <FontIcon iconLiteral="fas-file-contract" iconSize="15" />
                                        <Label style="-fx-font-size: 14px;" text="Mes contrats" />
                                    </children></HBox></graphic>
                                </Button>
        
                                <Button onAction="#handleApplications" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button">
                                    <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                        <FontIcon iconLiteral="fas-star" iconSize="15" />
                                        <Label style="-fx-font-size: 14px;" text="Avis &amp; Propositions" />
                                    </children></HBox></graphic>
                                </Button>
        
        
                                <Button fx:id="btnPaymentMethods" onAction="#handlePaymentMethods" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button">
                                    <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                        <FontIcon iconLiteral="fas-university" iconSize="15" />
                                        <Label style="-fx-font-size: 14px;" text="Moyens de Paiement" />
                                    </children></HBox></graphic>
                                </Button>
        
                                <Button fx:id="btnPayments" onAction="#handlePayments" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button">
                                    <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                        <FontIcon iconLiteral="fas-credit-card" iconSize="15" />
                                        <Label style="-fx-font-size: 14px;" text="Paiements" />
                                    </children></HBox></graphic>
                                </Button>
        
                                <Region VBox.vgrow="ALWAYS" />
                                <Separator />
        
        
        
                                <Button onAction="#handleLogout" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button, logout">
                                    <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                        <FontIcon iconLiteral="fas-sign-out-alt" iconSize="15" />
                                        <Label style="-fx-font-size: 14px;" text="Logout" />
                                    </children></HBox></graphic>
                                </Button>
        
        
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <!-- ══ Main Content ════════════════════════════════════════════════ -->
    <center>
        <StackPane fx:id="contentArea">
            <children>
                <ScrollPane fx:id="dashboardView" fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="10.0" styleClass="main-content">
                    <padding><Insets bottom="40.0" left="36.0" right="36.0" top="20.0" /></padding>
                    <children>

                        <!-- ── Profile Header Card ─────────────────────── -->
                        <VBox styleClass="profile-header-card">

                            <!-- Gradient banner strip -->
                            <Pane maxHeight="24.0" minHeight="24.0" styleClass="profile-banner">
                        <VBox.margin>
                           <Insets bottom="20.0" />
                        </VBox.margin></Pane>

                            <!-- Avatar + details row -->
                            <HBox alignment="BOTTOM_LEFT" spacing="22.0" styleClass="profile-header-body">
                                <padding><Insets bottom="20.0" left="28.0" right="28.0" top="0.0" /></padding>
                                <children>

                                    <!-- Avatar with camera overlay -->
                                    <StackPane styleClass="avatar-stack">
                                        <VBox.margin><Insets top="-38.0" /></VBox.margin>
                                        <children>
                                            <Pane prefHeight="138.0" prefWidth="138.0" styleClass="avatar-ring" />
                                            <ImageView fx:id="profileImageView" fitHeight="124.0" fitWidth="124.0" preserveRatio="true" styleClass="profile-avatar" StackPane.alignment="CENTER">
                                                <image><Image url="@../../images/default-avatar.jpg" /></image>
                                            </ImageView>
                                            <Button onAction="#handleChangePhoto" styleClass="btn-camera-overlay" StackPane.alignment="BOTTOM_RIGHT">
                                                <graphic>
                                                    <FontIcon iconLiteral="fas-camera" iconSize="11" styleClass="camera-icon" />
                                                </graphic>
                                                <tooltip><Tooltip text="Change photo" /></tooltip>
                                                <StackPane.margin><Insets bottom="5.0" right="5.0" /></StackPane.margin>
                                            </Button>
                                        </children>
                                    </StackPane>

                                    <!-- Name / email / company pills -->
                                    <VBox alignment="BOTTOM_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
                                        <padding><Insets bottom="2.0" /></padding>
                                        <children>
                                            <Label fx:id="nameLabel" styleClass="profile-name-large" text="Client Name">
                                                <font><Font name="System Bold" size="26.0" /></font>
                                            </Label>
                                            <Label fx:id="emailLabel" styleClass="profile-email-large" text="client@email.com">
                                                <font><Font size="13.0" /></font>
                                            </Label>

                                            <!-- Company + Industry pills -->
                                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                <children>
                                                    <HBox alignment="CENTER_LEFT" spacing="5.0" styleClass="stat-pill stat-pill-blue">
                                                        <padding><Insets bottom="4" left="10" right="10" top="4" /></padding>
                                                        <children>
                                                            <FontIcon iconLiteral="fas-building" iconSize="10" />
                                                            <Label fx:id="companyLabel" text="Company Name">
                                                                <font><Font size="12.0" /></font>
                                                            </Label>
                                                        </children>
                                                    </HBox>
                                                    <HBox alignment="CENTER_LEFT" spacing="5.0" styleClass="stat-pill stat-pill-green">
                                                        <padding><Insets bottom="4" left="10" right="10" top="4" /></padding>
                                                        <children>
                                                            <FontIcon iconLiteral="fas-industry" iconSize="10" />
                                                            <Label fx:id="industryLabel" text="Industry">
                                                                <font><Font size="12.0" /></font>
                                                            </Label>
                                                        </children>
                                                    </HBox>
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>

                                    <!-- Edit button top-right -->
                                    <VBox alignment="TOP_RIGHT">
                                        <padding><Insets top="12.0" /></padding>
                                        <children>
                                            <Button fx:id="editProfileButton" onAction="#handleEditProfile" styleClass="btn-primary">
                                                <graphic><HBox alignment="CENTER" spacing="7.0"><children>
                                                    <FontIcon iconLiteral="fas-pencil-alt" iconSize="12" />
                                                </children></HBox></graphic>
                                            </Button>
                                        </children>
                                    </VBox>

                                </children>
                            </HBox>
                        </VBox>

                        <!-- ── Statistics Cards ────────────────────────── -->
                        <HBox spacing="16.0">
                            <children>

                                <VBox spacing="10.0" styleClass="stat-card-new stat-card-yellow" HBox.hgrow="ALWAYS">
                                    <padding><Insets bottom="20.0" left="22.0" right="22.0" top="20.0" /></padding>
                                    <children>
                                        <Label fx:id="completedProjectsLabel" styleClass="stat-value">
                                            <font><Font name="System Bold" size="24.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <!-- ── Posted Projects Section ─────────────────── -->
                        <VBox styleClass="content-section" VBox.vgrow="ALWAYS">
                            <padding><Insets bottom="22.0" left="28.0" right="28.0" top="22.0" /></padding>
                            <children>

                                <!-- Section header + filter bar -->
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <VBox.margin><Insets bottom="14.0" /></VBox.margin>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <StackPane prefHeight="32.0" prefWidth="32.0" styleClass="section-icon-badge">
                                                    <children>
                                                        <FontIcon iconLiteral="fas-folder-open" iconSize="14" styleClass="section-badge-icon" />
                                                    </children>
                                                </StackPane>
                                                <Label styleClass="section-title" text="Posted Projects">
                                                    <font><Font name="System Bold" size="17.0" /></font>
                                                </Label>
                                            </children>
                                        </HBox>

                                        <Region HBox.hgrow="ALWAYS" />

                                        <!-- Filter controls -->
                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <children>
                                                <ComboBox fx:id="statusFilterCombo" prefWidth="130.0" promptText="All Status" styleClass="filter-combo">
                                                    <items>
                                                        <FXCollections fx:factory="observableArrayList">
                                                            <String fx:value="All Status" />
                                                            <String fx:value="Active" />
                                                            <String fx:value="Completed" />
                                                            <String fx:value="In Progress" />
                                                            <String fx:value="Cancelled" />
                                                        </FXCollections>
                                                    </items>
                                                </ComboBox>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="search-box">
                                                    <padding><Insets bottom="0" left="10" right="10" top="0" /></padding>
                                                    <children>
                                                        <FontIcon iconLiteral="fas-search" iconSize="13" styleClass="search-icon" />
                                                        <TextField fx:id="searchField" promptText="Search projects..." styleClass="search-field-inner">
                                                            <font><Font size="13.0" /></font>
                                                        </TextField>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <Separator>
                                    <VBox.margin><Insets bottom="12.0" /></VBox.margin>
                                </Separator>

                                <!-- Projects list -->
                                <ScrollPane fitToWidth="true" prefHeight="340.0" styleClass="projects-scroll">
                                    <content>
                                        <VBox fx:id="postedProjectsContainer" spacing="12.0">
                                            <padding><Insets top="4.0" /></padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
            </children>
        </StackPane>
    </center>

</BorderPane>
