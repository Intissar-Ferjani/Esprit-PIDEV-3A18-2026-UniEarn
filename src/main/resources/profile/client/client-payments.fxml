<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniearn.controller.profile.client.ClientPaymentsController"
            fitToWidth="true" style="-fx-background-color: #f8fafc;">

    <VBox spacing="20" style="-fx-background-color: #f8fafc;">
        <padding>
            <Insets top="20" right="30" bottom="20" left="30"/>
        </padding>

        <!-- Page Title -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 0;">
            <Label text="💳 My Payments" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
        </HBox>

        <!-- Stats Cards -->
        <HBox spacing="20">
            <!-- Card 1: To Pay -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);
                         -fx-border-width: 0 0 0 4; -fx-border-color: transparent transparent transparent #f59e0b;"
                  HBox.hgrow="ALWAYS" minWidth="150">
                <Label text="⏳ TO PAY" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: 600;"/>
                <Label fx:id="statToPayCount" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1e293b;">
                    <padding><Insets top="8"/></padding>
                </Label>
            </VBox>

            <!-- Card 2: Paid -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);
                         -fx-border-width: 0 0 0 4; -fx-border-color: transparent transparent transparent #22c55e;"
                  HBox.hgrow="ALWAYS" minWidth="150">
                <Label text="✅ PAID (ESCROW)" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: 600;"/>
                <Label fx:id="statPaidCount" text="0" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1e293b;">
                    <padding><Insets top="8"/></padding>
                </Label>
            </VBox>

            <!-- Card 3: Amount Due -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);
                         -fx-border-width: 0 0 0 4; -fx-border-color: transparent transparent transparent #f59e0b;"
                  HBox.hgrow="ALWAYS" minWidth="150">
                <Label text="💰 AMOUNT DUE" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: 600;"/>
                <Label fx:id="statAmountDue" text="0.00" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1e293b;">
                    <padding><Insets top="8"/></padding>
                </Label>
            </VBox>

            <!-- Card 4: Amount Secured -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);
                         -fx-border-width: 0 0 0 4; -fx-border-color: transparent transparent transparent #22c55e;"
                  HBox.hgrow="ALWAYS" minWidth="150">
                <Label text="🔥 AMOUNT SECURED" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8; -fx-font-weight: 600;"/>
                <Label fx:id="statAmountSecured" text="0.00" style="-fx-font-size: 28px; -fx-font-weight: 800; -fx-text-fill: #1e293b;">
                    <padding><Insets top="8"/></padding>
                </Label>
            </VBox>
        </HBox>

        <!-- Section: Contracts To Pay -->
        <VBox spacing="12" style="-fx-padding: 10 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 0 10 0; -fx-border-width: 0 0 2 0; -fx-border-color: transparent transparent #fde68a transparent;">
                <Label text="⏳ Contracts To Pay" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #d97706;"/>
                <Label text="(signed by both parties — payment pending)" style="-fx-font-size: 11px; -fx-font-weight: 500; -fx-text-fill: #b45309;"/>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 4, 0, 0, 2);">
                <TableView fx:id="toPayTable" style="-fx-background-color: transparent; -fx-background-radius: 8;">
                    <columns>
                        <TableColumn fx:id="toPayColId" text="#" prefWidth="60" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="toPayColTitle" text="CONTRACT TITLE" prefWidth="250"/>
                        <TableColumn fx:id="toPayColFreelancer" text="FREELANCER" prefWidth="180"/>
                        <TableColumn fx:id="toPayColAmount" text="AMOUNT" prefWidth="120" style="-fx-alignment: CENTER-RIGHT;"/>
                        <TableColumn fx:id="toPayColSignedOn" text="SIGNED ON" prefWidth="130" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="toPayColActions" text="ACTIONS" prefWidth="280" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40;">
                            <Label text="🎉" style="-fx-font-size: 40px;"/>
                            <Label text="No pending payments — all contracts are funded!" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-font-weight: 500;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>

        <!-- Section: Paid Contracts -->
        <VBox spacing="12" style="-fx-padding: 20 0 0 0;">
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 0 10 0; -fx-border-width: 0 0 2 0; -fx-border-color: transparent transparent #bbf7d0 transparent;">
                <Label text="✅ Paid Contracts (Escrow)" style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #166534;"/>
                <Label text="(funds secured in escrow)" style="-fx-font-size: 11px; -fx-font-weight: 500; -fx-text-fill: #15803d;"/>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 4, 0, 0, 2);">
                <TableView fx:id="paidTable" style="-fx-background-color: transparent; -fx-background-radius: 8;">
                    <columns>
                        <TableColumn fx:id="paidColId" text="#" prefWidth="60" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="paidColTitle" text="CONTRACT TITLE" prefWidth="250"/>
                        <TableColumn fx:id="paidColFreelancer" text="FREELANCER" prefWidth="180"/>
                        <TableColumn fx:id="paidColAmount" text="AMOUNT SECURED" prefWidth="150" style="-fx-alignment: CENTER-RIGHT;"/>
                        <TableColumn fx:id="paidColStatus" text="STATUS" prefWidth="130" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="paidColActions" text="ACTIONS" prefWidth="180" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="12" style="-fx-padding: 40;">
                            <Label text="💳" style="-fx-font-size: 40px;"/>
                            <Label text="No paid contracts yet." style="-fx-text-fill: #94a3b8; -fx-font-size: 13px; -fx-font-weight: 500;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>
        </VBox>

        <!-- Refresh Button -->
        <HBox alignment="CENTER_RIGHT" spacing="12">
            <padding><Insets top="12"/></padding>
            <Button text="🔄 Rafraîchir" onAction="#handleRefresh"
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>

    </VBox>
</ScrollPane>

