<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="uniearn.controller.profile.forum.MessagesController"
    prefHeight="600.0" prefWidth="900.0"
    style="-fx-background-color: #f5f5f5;">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15"
            style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Button fx:id="backButton" onAction="#goBack"
                text="← Back"
                style="-fx-background-color: transparent; -fx-text-fill: white;
                    -fx-font-size: 14px; -fx-cursor: hand;" />

            <Label text="💬 Messages" textFill="white">
                <font>
                    <Font name="System Bold" size="20" />
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <TextField fx:id="searchField" promptText="🔍 Search conversations..."
                prefWidth="250"
                style="-fx-background-radius: 20; -fx-padding: 8 15 8 15;
                              -fx-font-size: 12px;" />
        </HBox>
    </top>

    <!-- Center: Split pane with conversation list + chat view -->
    <center>
        <HBox style="-fx-padding: 0;">

            <!-- Left: Conversation List -->
            <VBox prefWidth="300"
                style="-fx-background-color: white; -fx-border-color: #e0e0e0;
                                         -fx-border-width: 0 1 0 0;">
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox fx:id="conversationList" spacing="0">
                        <!-- Conversations loaded dynamically by controller -->
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Right: Chat View -->
            <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #f8f9fa;">

                <!-- Chat Header -->
                <HBox spacing="12" alignment="CENTER_LEFT"
                    style="-fx-background-color: white; -fx-padding: 15;
                             -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                    <Label fx:id="chatHeaderInitial" text="?"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;
                           -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 12 8 12;
                           -fx-background-radius: 50;" />
                    <VBox spacing="2">
                        <Label fx:id="chatHeaderName" text="Select a conversation"
                            style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                        <Label fx:id="chatHeaderStatus" text=""
                            style="-fx-font-size: 11px; -fx-text-fill: #2ecc71;" />
                    </VBox>
                </HBox>

                <!-- Chat Messages -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox fx:id="chatMessages" spacing="12" style="-fx-padding: 20;">
                        <!-- Messages loaded dynamically by controller -->
                    </VBox>
                </ScrollPane>

                <!-- Message Input -->
                <HBox spacing="10" alignment="CENTER"
                    style="-fx-background-color: white; -fx-padding: 15;
                             -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
                    <TextField fx:id="messageInput" promptText="Type a message..."
                        HBox.hgrow="ALWAYS"
                        style="-fx-background-radius: 20; -fx-padding: 10 15 10 15;
                                      -fx-font-size: 13px; -fx-background-color: #f0f2f5;" />
                    <Button text="Send" onAction="#sendMessage"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;
                                   -fx-padding: 10 25 10 25; -fx-background-radius: 20;
                                   -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" />
                </HBox>
            </VBox>

        </HBox>
    </center>

</BorderPane>