<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root"
            stylesheets="@../../profile/forum/profile.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniearn.controller.profile.forum.FreelancerForumController">

    <!-- ═══════════════════════════════════════════ TOP BAR (same as dashboard) -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="68.0" spacing="20.0" styleClass="top-bar">
            <padding><Insets left="30.0" right="30.0" /></padding>
            <children>
                <Region HBox.hgrow="ALWAYS" />
                <ImageView fitHeight="260.0" fitWidth="185.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../images/UniEarn_full_logo.png" /></image>
                </ImageView>
            </children>
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════ LEFT SIDEBAR (same as dashboard) -->
    <left>
        <VBox prefWidth="248.0" styleClass="sidebar">
            <children>
                <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                    <padding><Insets bottom="15.0" left="14.0" right="14.0" top="22.0" /></padding>
                    <children>

                        <!-- Logged-in user display -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <padding><Insets bottom="8.0" /></padding>
                            <children>
                                <FontIcon iconLiteral="fas-user-circle" iconSize="28" style="-fx-icon-color: #1a56db;" />
                                <Label fx:id="sidebarUsernameLabel" text="Guest" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a56db;" />
                            </children>
                        </HBox>

                        <Separator />

                        <Button onAction="#handleBackToDashboard" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button">
                            <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                <FontIcon iconLiteral="fas-arrow-left" iconSize="15" />
                                <Label text="Back to Dashboard" style="-fx-font-size: 14px;" />
                            </children></HBox></graphic>
                        </Button>

                        <Separator />

                        <Button prefHeight="42.0" prefWidth="220.0" styleClass="nav-button, active">
                            <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                <FontIcon iconLiteral="fas-comments" iconSize="15" />
                                <Label text="Forum" style="-fx-font-size: 14px;" />
                            </children></HBox></graphic>
                        </Button>

                        <Button fx:id="messageButton" onAction="#openMessages" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button">
                            <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                <FontIcon iconLiteral="fas-envelope" iconSize="15" />
                                <Label text="Messages" style="-fx-font-size: 14px;" />
                            </children></HBox></graphic>
                        </Button>

                        <Button fx:id="notificationButton" onAction="#openNotifications" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button">
                            <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                <FontIcon iconLiteral="fas-bell" iconSize="15" />
                                <Label text="Notifications" style="-fx-font-size: 14px;" />
                                <Label fx:id="notificationBadge" text="0"
                                       style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                              -fx-background-radius: 10; -fx-padding: 1 6 1 6;
                                              -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            </children></HBox></graphic>
                        </Button>

                        <Region VBox.vgrow="ALWAYS" />
                        <Separator />

                        <Button onAction="#handleLogout" prefHeight="42.0" prefWidth="220.0" styleClass="nav-button, logout">
                            <graphic><HBox alignment="CENTER_LEFT" spacing="12.0"><children>
                                <FontIcon iconLiteral="fas-sign-out-alt" iconSize="15" />
                                <Label text="Logout" style="-fx-font-size: 14px;" />
                            </children></HBox></graphic>
                        </Button>

                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════ MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <content>
        <HBox spacing="20.0" styleClass="main-content">
            <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/></padding>
            <children>

                <!-- ════════════ LEFT COLUMN: Create New Post ════════════ -->
                <VBox spacing="16.0" styleClass="content-section" prefWidth="380.0" minWidth="340.0">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="18.0"/></padding>
                    <children>

                        <!-- Card header -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="✏ Create New Post" styleClass="section-title">
                                    <font><Font name="System Bold" size="17.0"/></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button onAction="#clearPost" styleClass="btn-secondary" text="✖ Clear">
                                    <font><Font size="11.0"/></font>
                                </Button>
                            </children>
                        </HBox>

                        <Separator/>

                        <!-- Title field -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Post Title *" styleClass="field-label-small">
                                    <font><Font name="System Bold" size="12.0"/></font>
                                </Label>
                                <TextField fx:id="postTitleField" promptText="Enter your post title…"
                                           style="-fx-background-color: #f8f9fa; -fx-border-color: #e1e8ed;
                                                  -fx-border-radius: 6; -fx-background-radius: 6;
                                                  -fx-padding: 8; -fx-font-size: 12;"/>
                            </children>
                        </VBox>

                        <!-- Category selector -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Category *" styleClass="field-label-small">
                                    <font><Font name="System Bold" size="12.0"/></font>
                                </Label>
                                <ComboBox fx:id="postCategoryCombo" maxWidth="Infinity"
                                          promptText="Select a category"
                                          style="-fx-background-color: #f8f9fa; -fx-border-color: #e1e8ed;
                                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12;"/>
                            </children>
                        </VBox>

                        <!-- Content area -->
                        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Content *" styleClass="field-label-small">
                                    <font><Font name="System Bold" size="12.0"/></font>
                                </Label>
                                <TextArea fx:id="postContentArea"
                                          promptText="Share your thoughts, questions, or experiences…"
                                          prefRowCount="6" wrapText="true"
                                          styleClass="description-area"
                                          style="-fx-font-size: 12;"
                                          VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>

                        <!-- GIF Preview for new post -->
                        <HBox fx:id="postGifContainer" spacing="10" alignment="CENTER_LEFT"
                              visible="false" managed="false">
                            <children>
                                <ImageView fx:id="postGifPreview" fitWidth="120" preserveRatio="true"/>
                                <Button text="✕" onAction="#removePostGif"
                                        styleClass="btn-danger" prefHeight="28.0">
                                    <font><Font size="11.0"/></font>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Action buttons -->
                        <HBox spacing="8.0" alignment="CENTER_RIGHT">
                            <children>
                                <Button text="🎬 GIF" onAction="#openGiphyPickerForPost"
                                        styleClass="btn-gif" prefHeight="34.0">
                                    <font><Font size="12.0"/></font>
                                </Button>
                                <Button text="📷 Image" onAction="#uploadImage"
                                        styleClass="btn-upload" prefHeight="34.0">
                                    <font><Font size="12.0"/></font>
                                </Button>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Cancel" onAction="#clearPost"
                                        styleClass="btn-secondary" prefHeight="34.0">
                                    <font><Font size="12.0"/></font>
                                </Button>
                                <Button text="📝 Post" onAction="#createPost"
                                        styleClass="btn-primary" prefHeight="34.0" prefWidth="100.0">
                                    <font><Font name="System Bold" size="12.0"/></font>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>

                <!-- ════════════ RIGHT COLUMN: Recent Posts ════════════ -->
                <VBox spacing="14.0" styleClass="content-section" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="18.0"/></padding>
                    <children>

                        <!-- Feed header row with filter -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Recent Posts" styleClass="section-title">
                                    <font><Font name="System Bold" size="17.0"/></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Filter:" style="-fx-text-fill: #555; -fx-font-size: 12px;"/>
                                <ComboBox fx:id="categoryFilter" promptText="All Categories"
                                          style="-fx-background-color: #f8f9fa; -fx-border-color: #e1e8ed;
                                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px;"/>
                            </children>
                        </HBox>

                        <Separator/>

                        <!-- Posts container (dynamically populated) -->
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    styleClass="content-scroll">
                            <content>
                                <VBox fx:id="postsContainer" spacing="15" style="-fx-padding: 5;"/>
                            </content>
                        </ScrollPane>

                    </children>
                </VBox>

            </children>
        </HBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>