<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root"
            stylesheets="@../forum/profile.css"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniearn.controller.profile.forum.FreelancerForumController">

    <!-- ═══════════════════════════════════════════════════════ TOP BAR -->
    <top>
        <VBox>
            <!-- Primary nav bar -->
            <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="0.0" styleClass="top-bar">
                <padding><Insets left="30.0" right="30.0"/></padding>
                <children>
                    <Label text="Forum" textFill="white">
                        <font><Font name="System Bold" size="22.0"/></font>
                    </Label>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Navigation buttons -->
                    <Button onAction="#handleBackToDashboard" styleClass="nav-top-button" text="🏠 Dashboard">
                        <font><Font size="13.0"/></font>
                    </Button>
                    <Button styleClass="nav-top-button, nav-top-active" text="💬 Forum">
                        <font><Font size="13.0"/></font>
                    </Button>
                    <Button fx:id="messageButton" onAction="#openMessages" styleClass="nav-top-button" text="✉ Messages">
                        <font><Font size="13.0"/></font>
                    </Button>
                    <Button fx:id="notificationButton" onAction="#openNotifications" styleClass="nav-top-button">
                        <font><Font size="13.0"/></font>
                        <graphic>
                            <HBox alignment="CENTER" spacing="4">
                                <Label text="🔔 Notifications" style="-fx-text-fill: white; -fx-font-size: 13px;"/>
                                <Label fx:id="notificationBadge" text="0"
                                       style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                              -fx-background-radius: 10; -fx-padding: 1 6 1 6;
                                              -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Region prefWidth="20.0"/>

                    <Button onAction="#handleLogout" styleClass="nav-top-button"
                            style="-fx-border-color: rgba(255,255,255,0.3); -fx-border-radius: 6; -fx-background-radius: 6;"
                            text="🚪 Logout">
                        <font><Font size="13.0"/></font>
                    </Button>
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════════════════════════════════════════════ MAIN CONTENT -->
    <center>
        <HBox spacing="20.0" styleClass="main-content">
            <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/></padding>
            <children>

                <!-- ════════════ LEFT COLUMN: Create New Post ════════════ -->
                <VBox spacing="16.0" styleClass="content-section" prefWidth="380.0" minWidth="340.0">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="18.0"/></padding>
                    <children>

                        <!-- Card header -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="✏ Create New Post" styleClass="section-title">
                                    <font><Font name="System Bold" size="17.0"/></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button onAction="#clearPost" styleClass="btn-secondary" text="✖ Clear">
                                    <font><Font size="11.0"/></font>
                                </Button>
                            </children>
                        </HBox>

                        <Separator/>

                        <!-- Title field -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Post Title *" styleClass="field-label-small">
                                    <font><Font name="System Bold" size="12.0"/></font>
                                </Label>
                                <TextField fx:id="postTitleField" promptText="Enter your post title…"
                                           style="-fx-background-color: #f8f9fa; -fx-border-color: #e1e8ed;
                                                  -fx-border-radius: 6; -fx-background-radius: 6;
                                                  -fx-padding: 8; -fx-font-size: 12;"/>
                            </children>
                        </VBox>

                        <!-- Category selector -->
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Category *" styleClass="field-label-small">
                                    <font><Font name="System Bold" size="12.0"/></font>
                                </Label>
                                <ComboBox fx:id="postCategoryCombo" maxWidth="Infinity"
                                          promptText="Select a category"
                                          style="-fx-background-color: #f8f9fa; -fx-border-color: #e1e8ed;
                                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12;"/>
                            </children>
                        </VBox>

                        <!-- Content area -->
                        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Content *" styleClass="field-label-small">
                                    <font><Font name="System Bold" size="12.0"/></font>
                                </Label>
                                <TextArea fx:id="postContentArea"
                                          promptText="Share your thoughts, questions, or experiences…"
                                          prefRowCount="6" wrapText="true"
                                          styleClass="description-area"
                                          style="-fx-font-size: 12;"
                                          VBox.vgrow="ALWAYS"/>
                            </children>
                        </VBox>

                        <!-- GIF Preview for new post -->
                        <HBox fx:id="postGifContainer" spacing="10" alignment="CENTER_LEFT"
                              visible="false" managed="false">
                            <children>
                                <ImageView fx:id="postGifPreview" fitWidth="120" preserveRatio="true"/>
                                <Button text="✕" onAction="#removePostGif"
                                        styleClass="btn-danger" prefHeight="28.0">
                                    <font><Font size="11.0"/></font>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Action buttons -->
                        <HBox spacing="8.0" alignment="CENTER_RIGHT">
                            <children>
                                <Button text="🎬 GIF" onAction="#openGiphyPickerForPost"
                                        styleClass="btn-gif" prefHeight="34.0">
                                    <font><Font size="12.0"/></font>
                                </Button>
                                <Button text="📷 Image" onAction="#uploadImage"
                                        styleClass="btn-upload" prefHeight="34.0">
                                    <font><Font size="12.0"/></font>
                                </Button>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Cancel" onAction="#clearPost"
                                        styleClass="btn-secondary" prefHeight="34.0">
                                    <font><Font size="12.0"/></font>
                                </Button>
                                <Button text="📝 Post" onAction="#createPost"
                                        styleClass="btn-primary" prefHeight="34.0" prefWidth="100.0">
                                    <font><Font name="System Bold" size="12.0"/></font>
                                </Button>
                            </children>
                        </HBox>

                    </children>
                </VBox>

                <!-- ════════════ RIGHT COLUMN: Recent Posts ════════════ -->
                <VBox spacing="14.0" styleClass="content-section" HBox.hgrow="ALWAYS">
                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="18.0"/></padding>
                    <children>

                        <!-- Feed header row with filter -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Recent Posts" styleClass="section-title">
                                    <font><Font name="System Bold" size="17.0"/></font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Filter:" style="-fx-text-fill: #555; -fx-font-size: 12px;"/>
                                <ComboBox fx:id="categoryFilter" promptText="All Categories"
                                          style="-fx-background-color: #f8f9fa; -fx-border-color: #e1e8ed;
                                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px;"/>
                            </children>
                        </HBox>

                        <Separator/>

                        <!-- Posts container (dynamically populated) -->
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    styleClass="content-scroll">
                            <content>
                                <VBox fx:id="postsContainer" spacing="15" style="-fx-padding: 5;"/>
                            </content>
                        </ScrollPane>

                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

</BorderPane>