<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="25.0" styleClass="main-content" stylesheets="@../../profile/profile.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uniearn.controller.profile.freelancer.ListFreelancersController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label styleClass="section-title" text="👥 Browse Freelancers">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="resultsCountLabel" styleClass="profile-tag" text="0 freelancers found">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
            </children>
        </HBox>

        <!-- Tabs -->
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="main-tab-pane">
            <tabs>
                <!-- TAB 1: Browse All -->
                <Tab text="Browse All">
                    <content>
                        <VBox spacing="15.0">
                            <!-- Search and Filter Bar -->
                            <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="profile-header">
                                <padding>
                                    <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                                </padding>
                                <children>
                                    <!-- Search Field -->
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                        <children>
                                            <TextField fx:id="searchField" prefWidth="400.0" promptText="🔍 Search by name, skills, or bio..." styleClass="search-field">
                                                <font>
                                                    <Font size="14.0" />
                                                </font>
                                                <VBox.margin>
                                                    <Insets top="16.0" />
                                                </VBox.margin>
                                            </TextField>
                                        </children>
                                    </VBox>

                                    <!-- Filters Group -->
                                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                                        <children>
                                            <!-- Verification Status Filter -->
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="filter-label" text="Status">
                                                        <font>
                                                            <Font size="12.0" />
                                                        </font>
                                                    </Label>
                                                    <ComboBox fx:id="verificationFilterCombo" prefWidth="130.0" styleClass="filter-combo">
                                                        <items>
                                                            <FXCollections fx:factory="observableArrayList">
                                                                <String fx:value="All" />
                                                                <String fx:value="Verified" />
                                                                <String fx:value="Unverified" />
                                                            </FXCollections>
                                                        </items>
                                                    </ComboBox>
                                                </children>
                                            </VBox>

                                            <!-- Rating Filter -->
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="filter-label" text="Rating">
                                                        <font>
                                                            <Font size="12.0" />
                                                        </font>
                                                    </Label>
                                                    <ComboBox fx:id="ratingFilterCombo" prefWidth="110.0" styleClass="filter-combo">
                                                        <items>
                                                            <FXCollections fx:factory="observableArrayList">
                                                                <String fx:value="Any" />
                                                                <String fx:value="4.0+" />
                                                                <String fx:value="4.5+" />
                                                            </FXCollections>
                                                        </items>
                                                    </ComboBox>
                                                </children>
                                            </VBox>

                                            <!-- Sort By -->
                                            <VBox spacing="5.0">
                                                <children>
                                                    <Label styleClass="filter-label" text="Sort By">
                                                        <font>
                                                            <Font size="12.0" />
                                                        </font>
                                                    </Label>
                                                    <ComboBox fx:id="sortByCombo" prefWidth="150.0" styleClass="filter-combo">
                                                        <items>
                                                            <FXCollections fx:factory="observableArrayList">
                                                                <String fx:value="Rating (High)" />
                                                                <String fx:value="Rating (Low)" />
                                                                <String fx:value="Price (Low)" />
                                                                <String fx:value="Price (High)" />
                                                                <String fx:value="Name (A-Z)" />
                                                            </FXCollections>
                                                        </items>
                                                    </ComboBox>
                                                </children>
                                            </VBox>

                                            <!-- Clear Filters Button -->
                                            <VBox alignment="BOTTOM_CENTER">
                                                <children>
                                                    <Button onAction="#handleClearFilters" prefHeight="34.0" prefWidth="96.0" styleClass="btn-secondary" text="Clear">
                                                        <font>
                                                            <Font size="12.0" />
                                                        </font>
                                                    </Button>
                                                </children>
                                                <VBox.margin>
                                                    <Insets top="20.0" />
                                                </VBox.margin>
                                            </VBox>
                                        </children>
                                    </HBox>
                                </children>
                            </HBox>

                            <!-- Freelancers List -->
                            <VBox spacing="15.0" styleClass="content-section" VBox.vgrow="ALWAYS">
                                <padding>
                                    <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                                </padding>
                                <children>
                                    <ScrollPane fitToWidth="true" prefHeight="500.0" styleClass="projects-scroll">
                                        <content>
                                            <VBox fx:id="freelancersContainer" spacing="15.0">
                                                <padding>
                                                    <Insets top="5.0" />
                                                </padding>
                                                <!-- Freelancer cards loaded dynamically -->
                                            </VBox>
                                        </content>
                                    </ScrollPane>
                                </children>
                            </VBox>
                        </VBox>
                    </content>
                </Tab>

                <!-- TAB 2: AI Recommended -->
                <Tab fx:id="aiTab" text="✨ AI Recommended">
                    <content>
                        <VBox spacing="15.0" styleClass="content-section">
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                            </padding>
                            <children>
                                <!-- AI Filter Bar -->
                                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="profile-header">
                                    <padding>
                                        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                                    </padding>
                                    <children>
                                        <!-- Target Project -->
                                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="filter-label" text="TARGET PROJECT">
                                                    <font>
                                                        <Font size="12.0" />
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="aiTargetProjectCombo" prefWidth="400.0" styleClass="filter-combo" />
                                            </children>
                                        </VBox>
                                        
                                        <!-- Min Rating -->
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label styleClass="filter-label" text="MIN RATING">
                                                    <font>
                                                        <Font size="12.0" />
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="aiMinRatingCombo" prefWidth="110.0" styleClass="filter-combo">
                                                    <items>
                                                        <FXCollections fx:factory="observableArrayList">
                                                            <String fx:value="Any" />
                                                            <String fx:value="4.0+" />
                                                            <String fx:value="4.5+" />
                                                        </FXCollections>
                                                    </items>
                                                </ComboBox>
                                            </children>
                                        </VBox>
                                        
                                        <!-- Max Price -->
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label styleClass="filter-label" text="MAX PRICE/HR">
                                                    <font>
                                                        <Font size="12.0" />
                                                    </font>
                                                </Label>
                                                <ComboBox fx:id="aiMaxPriceCombo" prefWidth="110.0" styleClass="filter-combo">
                                                    <items>
                                                        <FXCollections fx:factory="observableArrayList">
                                                            <String fx:value="Any" />
                                                            <String fx:value="20" />
                                                            <String fx:value="50" />
                                                            <String fx:value="100" />
                                                        </FXCollections>
                                                    </items>
                                                </ComboBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <Label text="AI Matches for your Active Projects" styleClass="section-title">
                                        <font>
                                            <Font name="System Bold" size="18.0" />
                                        </font>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <ProgressIndicator fx:id="aiLoadingIndicator" visible="false" prefWidth="24.0" prefHeight="24.0"/>
                                </HBox>
                                <Label fx:id="aiErrorLabel" textFill="#e74c3c" visible="false" managed="false" wrapText="true" />
                                <ScrollPane fitToWidth="true" styleClass="projects-scroll" VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox fx:id="aiRecommendationsContainer" spacing="15.0">
                                            <padding>
                                                <Insets top="5.0" />
                                            </padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

    </children>
</VBox>

