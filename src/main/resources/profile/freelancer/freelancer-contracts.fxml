<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="15" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.profile.freelancer.FreelancerContractsController">

    <!-- En-tête avec titre et boutons de recherche/filtre -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 8; -fx-background-radius: 8;">
        <Label text="📄 Mes Contrats" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1a202c;"/>

        <HBox spacing="15">
            <TextField fx:id="searchField" promptText="Rechercher un contrat..." prefWidth="250" style="-fx-padding: 10; -fx-font-size: 12;"/>

            <ComboBox fx:id="statusFilter" prefWidth="150" style="-fx-padding: 10; -fx-font-size: 12;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🔄 Rafraîchir" style="-fx-padding: 10 20; -fx-font-size: 12; -fx-background-color: #FFC107; -fx-text-fill: black; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>

    <!-- Zone de contrats -->
    <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-padding: 0;">
        <VBox fx:id="contractsContainer" spacing="15" style="-fx-padding: 0;">
            <Label fx:id="noContractsLabel" text="Aucun contrat trouvé"
                   style="-fx-text-fill: #95a5a6; -fx-font-size: 16; -fx-padding: 40;"
                   alignment="CENTER" visible="true"/>
        </VBox>
    </ScrollPane>
</VBox>

