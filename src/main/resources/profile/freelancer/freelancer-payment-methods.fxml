<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" stylesheets="@../../profile/profile.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.profile.freelancer.FreelancerPaymentMethodsController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- Header -->
    <VBox spacing="10.0">
        <children>
            <Label styleClass="section-title" text="🏦 Moyens de Paiement">
                <font>
                    <Font name="System Bold" size="28.0" />
                </font>
            </Label>
            <Label styleClass="section-description" text="Gérez vos comptes bancaires pour recevoir les paiements">
                <font>
                    <Font size="13.0" />
                </font>
            </Label>
        </children>
    </VBox>

    <!-- Add Account Button -->
    <HBox spacing="15.0">
        <children>
            <Button fx:id="addAccountButton" prefHeight="40.0" prefWidth="160.0" styleClass="btn-primary" text="+ Ajouter un compte">
                <font>
                    <Font size="13.0" />
                </font>
            </Button>
        </children>
    </HBox>

    <!-- Form Section -->
    <VBox spacing="15.0" styleClass="form-container" style="-fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-padding: 20;">
        <children>
            <Label styleClass="section-subtitle" text="Nouveau Compte Bancaire">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>

            <!-- Account Holder Name -->
            <VBox spacing="5.0">
                <children>
                    <Label text="Titulaire du Compte" styleClass="form-label" />
                    <TextField fx:id="accountHolderNameField" promptText="Nom du titulaire" styleClass="form-input" />
                </children>
            </VBox>

            <!-- Bank Name -->
            <VBox spacing="5.0">
                <children>
                    <Label text="Nom de la Banque" styleClass="form-label" />
                    <TextField fx:id="bankNameField" promptText="Ex: BNP Paribas" styleClass="form-input" />
                </children>
            </VBox>

            <!-- IBAN -->
            <VBox spacing="5.0">
                <children>
                    <Label text="IBAN" styleClass="form-label" />
                    <TextField fx:id="ibanField" promptText="FR1420041010050500013M02606" styleClass="form-input" />
                </children>
            </VBox>

            <!-- Message Label -->
            <Label fx:id="messageLabel" styleClass="form-message" text="" />

            <!-- Action Buttons -->
            <HBox spacing="10.0">
                <children>
                    <Button fx:id="addAccountButton" prefHeight="35.0" prefWidth="120.0" styleClass="btn-success" text="Ajouter">
                        <font>
                            <Font size="12.0" />
                        </font>
                    </Button>
                    <Button fx:id="cancelButton" prefHeight="35.0" prefWidth="120.0" styleClass="btn-secondary" text="Annuler">
                        <font>
                            <Font size="12.0" />
                        </font>
                    </Button>
                </children>
            </HBox>
        </children>
    </VBox>

    <!-- Accounts List -->
    <VBox spacing="15.0">
        <children>
            <Label styleClass="section-subtitle" text="Comptes bancaires enregistrés:" />

            <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="content-scroll">
                <content>
                    <VBox fx:id="bankAccountsContainer" spacing="12.0" />
                </content>
            </ScrollPane>
        </children>
    </VBox>

    <!-- Security Notice -->
    <HBox spacing="10.0" styleClass="notice-box" style="-fx-border-color: #4CAF50; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #E8F5E9;">
        <children>
            <Label text="🔒" />
            <Label text="Vos données bancaires sont sécurisées et chiffrées. Elles ne sont utilisées que pour recevoir les paiements de vos contrats." styleClass="section-description" wrapText="true" />
        </children>
    </HBox>

</VBox>

