<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root" stylesheets="@../../profile/profile.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.profile.freelancer.FreelancerProfileController">

    <!-- Top Navigation Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" styleClass="top-bar">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>
                <Region HBox.hgrow="ALWAYS" />

                <ImageView fitHeight="280.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../images/UniEarn_full_logo.png" />
                    </image>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                </ImageView>

            </children>
        </HBox>
    </top>

    <!-- Left Sidebar Navigation -->
    <left>
        <VBox prefWidth="250.0" styleClass="sidebar">
            <children>
                <!-- Navigation Menu -->
                <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="20.0" />
                    </padding>
                    <children>
                        <Button prefHeight="40.0" prefWidth="220.0" styleClass="nav-button, active" text="🏠 Dashboard">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button prefHeight="40.0" prefWidth="220.0" styleClass="nav-button" text="📋 Projets disponibles">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button prefHeight="40.0" prefWidth="220.0" styleClass="nav-button" text="📝 Mes contrats">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button onAction="#handleViewPortfolio" prefHeight="40.0" prefWidth="220.0" styleClass="nav-button" text="💼 Portfolio">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button prefHeight="40.0" prefWidth="220.0" styleClass="nav-button" text="💬 Messages">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button prefHeight="40.0" prefWidth="220.0" styleClass="nav-button" text="💳 Paiements">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Region VBox.vgrow="ALWAYS" />

                        <Separator />

                        <Button onAction="#handleSettings" prefHeight="40.0" prefWidth="220.0" styleClass="nav-button" text="⚙ Settings">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>

                        <Button onAction="#handleLogout" prefHeight="40.0" prefWidth="220.0" styleClass="nav-button, logout" text="🚪 Logout">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="content-scroll">
            <content>
                <VBox spacing="25.0" styleClass="main-content">
                    <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>

                        <!-- Profile Header Section -->
                        <HBox alignment="CENTER_LEFT" spacing="30.0" styleClass="profile-header">
                            <padding>
                                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
                            </padding>
                            <children>
                                <!-- Profile Picture -->
                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <StackPane styleClass="profile-picture-container">
                                            <children>
                                                <ImageView fx:id="profileImageView" fitHeight="120.0" fitWidth="120.0" preserveRatio="true">
                                                    <image>
                                                        <Image url="@../../images/default-avatar.jpg" />
                                                    </image>
                                                </ImageView>
                                            </children>
                                        </StackPane>
                                        <Button onAction="#handleChangePhoto" styleClass="btn-secondary-small" text="📷 Change Photo">
                                            <font>
                                                <Font size="11.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </VBox>

                                <!-- Profile Info -->
                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="nameLabel" styleClass="profile-name-large" text="Freelancer Name">
                                            <font>
                                                <Font name="System Bold" size="28.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="emailLabel" styleClass="profile-email-large" text="freelancer@email.com">
                                            <font>
                                                <Font size="15.0" />
                                            </font>
                                        </Label>
                                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                                            <children>
                                                <Label fx:id="priceLabel" styleClass="profile-tag" text="25.00 TND/hr">
                                                    <font>
                                                        <Font size="13.0" />
                                                    </font>
                                                </Label>
                                                <Label styleClass="separator" text="•" />
                                                <Label fx:id="ratingLabel" styleClass="profile-tag" text="⭐ 4.5">
                                                    <font>
                                                        <Font size="13.0" />
                                                    </font>
                                                </Label>
                                                <Label styleClass="separator" text="•" />
                                                <Label fx:id="verificationLabel" styleClass="profile-tag" text="✓ Verified">
                                                    <font>
                                                        <Font size="13.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>
                                        <!-- Skills -->
                                        <HBox fx:id="skillsContainer" alignment="CENTER_LEFT" spacing="8.0">
                                            <!-- Skills loaded dynamically -->
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Actions -->
                                <VBox alignment="TOP_RIGHT" spacing="10.0">
                                    <children>
                                        <Button fx:id="editProfileButton" onAction="#handleEditProfile" styleClass="btn-primary" text="✏ Edit Profile">
                                            <font>
                                                <Font size="13.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Statistics Cards -->
                        <HBox spacing="20.0" />

                        <!-- Bio Section -->
                        <VBox spacing="15.0" styleClass="content-section">
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                            </padding>
                            <children>
                                <Label styleClass="section-title" text="About Me">
                                    <font>
                                        <Font name="System Bold" size="20.0" />
                                    </font>
                                </Label>
                                <Separator />
                                <Label fx:id="bioLabel" styleClass="bio-text" text="No bio available" wrapText="true">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Quick Access to Portfolio -->
                        <VBox fx:id="portfolioSection" spacing="15.0" styleClass="content-section">
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER" spacing="15.0">
                                    <children>
                                        <VBox alignment="CENTER" spacing="10.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label style="-fx-font-size: 48px;" text="💼" />
                                                <Label styleClass="section-title" text="Showcase Your Work">
                                                    <font>
                                                        <Font name="System Bold" size="18.0" />
                                                    </font>
                                                </Label>
                                                <Label style="-fx-text-fill: #666; -fx-font-size: 13px;" text="Build your portfolio to attract more clients" />
                                                <Button onAction="#handleViewPortfolio" styleClass="btn-primary" text="View My Portfolio →">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </Button>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>