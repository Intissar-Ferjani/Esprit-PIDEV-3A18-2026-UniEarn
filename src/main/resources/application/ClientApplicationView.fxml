<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="uniearn.controller.ClientApplicationController"
            style="-fx-background-color: #F8FAFC;">

    <!-- ================== LEFT SIDEBAR (List) ================== -->
    <left>
        <VBox spacing="0"
              style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;"
              prefWidth="340">

            <!-- Sidebar Header -->
            <VBox spacing="15" style="-fx-padding: 20; -fx-background-color: white;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Client Dashboard"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="ADMIN" style="-fx-background-color: #DBEAFE; -fx-text-fill: #1E40AF; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 4 8; -fx-background-radius: 4;"/>
                </HBox>

                <Label text="Received Applications" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>

                <HBox spacing="10">
                    <TextField fx:id="txtSearchTerm"
                               promptText="Search Project ID..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #F1F5F9; -fx-background-radius: 6; -fx-padding: 8;"/>
                </HBox>

                <ComboBox fx:id="cmbStatusFilter"
                          promptText="Filter by Status"
                          maxWidth="Infinity"
                          style="-fx-background-color: #F1F5F9; -fx-background-radius: 6;"/>
            </VBox>

            <Separator style="-fx-opacity: 0.5;"/>

            <!-- List of Applications -->
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: white; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox fx:id="sidebarListContainer" spacing="0" style="-fx-background-color: white;"/>
            </ScrollPane>
        </VBox>
    </left>


    <!-- ================== MAIN CONTENT AREA ================== -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 0;">

            <!-- VIEW 1: EMPTY STATE (Default) -->
            <VBox fx:id="viewEmpty" alignment="CENTER" spacing="20" style="-fx-background-color: #F8FAFC;">
                <Label text="Select a candidate to review"
                       style="-fx-font-size: 18px; -fx-text-fill: #94A3B8;"/>
            </VBox>


            <!-- VIEW 2: DETAILS VIEW -->
            <VBox fx:id="viewDetails" spacing="0" visible="false" style="-fx-background-color: #F8FAFC;">
                <!-- Header -->
                <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 30; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                    <VBox>
                        <Label fx:id="lblDetailId" text="Application #1024" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                        <Label fx:id="lblDetailDate" text="Submitted on 2023-10-25" style="-fx-text-fill: #64748B;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblDetailStatus" text="PENDING"
                           style="-fx-padding: 5 12; -fx-background-color: #FEF3C7; -fx-text-fill: #D97706; -fx-background-radius: 12; -fx-font-weight: bold; -fx-font-size: 12px;"/>
                </HBox>

                <!-- Scrollable Content -->
                <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox spacing="25" style="-fx-padding: 40; -fx-background-color: #F8FAFC;">

                        <!-- Info Cards -->
                        <HBox spacing="20">
                            <!-- Candidate Card -->
                            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                                <Label text="Candidate Info" style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 12px; text-transform: uppercase;"/>
                                <HBox alignment="CENTER_LEFT" spacing="15">
                                    <Circle radius="22" fill="#F1F5F9" stroke="#E2E8F0"/>
                                    <VBox>
                                        <Label fx:id="lblDetailFreelancerId" text="Freelancer ID: 45" style="-fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 16px;"/>
                                        <Label text="View Profile →" style="-fx-text-fill: #4F46E5; -fx-font-size: 12px; -fx-cursor: hand;"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <!-- Project Card -->
                            <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                                <Label text="Target Project" style="-fx-font-weight: bold; -fx-text-fill: #64748B; -fx-font-size: 12px; text-transform: uppercase;"/>
                                <Label fx:id="lblDetailProjectId" text="Project ID: 88" style="-fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                <Label text="Budget matching: +5%" style="-fx-text-fill: #10B981; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>

                        <!-- Proposal Details -->
                        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;">
                            <Label text="Proposal" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                            <Separator/>

                            <HBox spacing="40">
                                <VBox spacing="5">
                                    <Label text="Proposed Budget" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                                    <Label fx:id="lblDetailBudget" text="\$2,500.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Estimated Duration" style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
                                    <Label fx:id="lblDetailDuration" text="14 Days" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                                </VBox>
                            </HBox>

                            <Label text="Cover Letter" style="-fx-text-fill: #64748B; -fx-font-size: 12px; -fx-padding: 10 0 0 0;"/>
                            <TextFlow style="-fx-background-color: #F8FAFC; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;">
                                <Text fx:id="txtDetailCoverLetter" text="I have extensive experience..." style="-fx-fill: #334155; -fx-font-family: 'Segoe UI', sans-serif; -fx-font-size: 14px;"/>
                            </TextFlow>
                        </VBox>

                    </VBox>
                </ScrollPane>

                <!-- Action Bar (Client Specific) -->
                <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 20 40; -fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
                    <Button text="Reject Candidate" onAction="#handleReject"
                            style="-fx-background-color: white; -fx-text-fill: #EF4444; -fx-border-color: #EF4444; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 20;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✓ Accept Proposal" onAction="#handleAccept"
                            style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 10 30; -fx-font-size: 14px; -fx-effect: dropshadow(gaussian, rgba(16, 185, 129, 0.3), 10, 0, 0, 4);"/>
                </HBox>
            </VBox>

            <!-- MESSAGE TOAST -->
             <VBox fx:id="messageContainer" visible="false" managed="false" alignment="BOTTOM_CENTER" pickOnBounds="false" style="-fx-padding: 20;">
                <Label fx:id="lblMessage" text="Operation Successful" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 2);"/>
             </VBox>

        </StackPane>
    </center>

</BorderPane>
