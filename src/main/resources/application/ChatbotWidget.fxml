<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uniearn.controller.shared.ChatbotWidgetController"
      fx:id="chatbotRoot"
      prefWidth="380.0"
      maxWidth="380.0"
      spacing="0"
      visible="false"
      managed="false"
      style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-color: #d9e2ec; -fx-effect: dropshadow(gaussian, rgba(15,23,42,0.18), 24, 0, 0, 8);">

    <children>
        <VBox spacing="14.0" style="-fx-padding: 18; -fx-background-color: linear-gradient(to right, #0f172a, #1e3a8a); -fx-background-radius: 18 18 0 0;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="🤖 UniBuddy" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="×" onAction="#handleCloseWidget"
                            style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-background-radius: 999; -fx-cursor: hand; -fx-font-size: 15px; -fx-font-weight: bold; -fx-min-width: 30; -fx-min-height: 30;"/>
                </HBox>
                <Label text="Assistant UniEarn pour clients et freelancers" wrapText="true"
                       style="-fx-text-fill: rgba(255,255,255,0.78); -fx-font-size: 12px;"/>
            </children>
        </VBox>

        <ScrollPane fx:id="chatScrollPane" fitToWidth="true" prefViewportHeight="340.0"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #f8fafc; -fx-background: #f8fafc; -fx-border-color: transparent;">
            <content>
                <VBox fx:id="chatMessages" spacing="10.0" style="-fx-padding: 16; -fx-background-color: #f8fafc;"/>
            </content>
        </ScrollPane>

        <VBox spacing="10.0" style="-fx-padding: 14 16 16 16; -fx-background-color: white; -fx-background-radius: 0 0 18 18; -fx-border-color: #edf2f7; -fx-border-width: 1 0 0 0;">
            <children>
                <TextField fx:id="messageInput" promptText="Écrivez votre question sur UniEarn..."
                           onAction="#handleSendMessage"
                           style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-border-color: #dbe4ee; -fx-border-radius: 14; -fx-padding: 12 14; -fx-font-size: 13px;"/>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="statusLabel" text="Prêt" style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="sendButton" text="Envoyer" onAction="#handleSendMessage"
                            style="-fx-background-color: linear-gradient(to right, #0d6efd, #2563eb); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 12; -fx-cursor: hand; -fx-padding: 10 16;"/>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>