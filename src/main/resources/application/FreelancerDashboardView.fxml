<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<HBox spacing="1" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.profile.freelancer.FreelancerDashboardController">
    <children>
        <VBox prefWidth="350" style="-fx-background-color: white; -fx-border-color: #e4ebe4; -fx-border-width: 0 1 0 0;">
            <VBox spacing="15" style="-fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Freelancer" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #001e00;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleAdd" text="+" style="-fx-background-color: #00457c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 15; -fx-min-width: 30; -fx-min-height: 30; -fx-cursor: hand;"/>
                </HBox>

                <!-- MODE TOGGLE BUTTONS -->
                <VBox spacing="5" style="-fx-padding: 5 0;">
                    <HBox spacing="8">
                        <Button fx:id="btnTglApps" onAction="#handleShowApps" text="Applications" style="-fx-background-color: #00457c; -fx-text-fill: white; -fx-font-size: 11px; -fx-background-radius: 4; -fx-cursor: hand; -fx-pref-width: 90;"/>
                        <Button fx:id="btnTglEvals" onAction="#handleShowEvals" text="Reviews" style="-fx-background-color: white; -fx-text-fill: #00457c; -fx-border-color: #00457c; -fx-border-radius: 4; -fx-font-size: 11px; -fx-background-radius: 4; -fx-cursor: hand; -fx-pref-width: 80;"/>
                        <Button fx:id="btnTglStats" onAction="#handleShowStats" text="Stats" style="-fx-background-color: white; -fx-text-fill: #00457c; -fx-border-color: #00457c; -fx-border-radius: 4; -fx-font-size: 11px; -fx-background-radius: 4; -fx-cursor: hand; -fx-pref-width: 60;"/>
                    </HBox>
                </VBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtSearch" promptText="Search projects..." style="-fx-background-color: #f9f9f9; -fx-border-color: #e4ebe4; -fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 8;" HBox.hgrow="ALWAYS"/>
                    <Button onAction="#handleRefresh" text="↻" style="-fx-background-color: white; -fx-text-fill: #00457c; -fx-border-color: #e4ebe4; -fx-background-radius: 8; -fx-border-radius: 8; -fx-cursor: hand; -fx-min-width: 35; -fx-min-height: 35; -fx-font-size: 16px;"/>
                </HBox>
                <ComboBox fx:id="cmbFilter" maxWidth="Infinity" style="-fx-background-color: #f9f9f9; -fx-border-color: #e4ebe4; -fx-background-radius: 8;"/>
            </VBox>
            <ScrollPane fitToWidth="true" style="-fx-background: white; -fx-background-color: white;" VBox.vgrow="ALWAYS">
                <VBox fx:id="sidebarListContainer" spacing="0"/>
            </ScrollPane>
        </VBox>
        
        <StackPane fx:id="mainContent" HBox.hgrow="ALWAYS" style="-fx-padding: 30; -fx-background-color: #f9f9f9;">
            <VBox fx:id="viewEmpty" alignment="CENTER" spacing="20">
                <Label text="Manage your professional documents" style="-fx-font-size: 16px; -fx-text-fill: #5e6d55;"/>
            </VBox>
            
            <!-- APPLICATION DETAILS -->
            <VBox fx:id="viewAppDetails" spacing="25" visible="false">
                <HBox alignment="BOTTOM_LEFT" spacing="15">
                    <Label text="Application Details" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #001e00;"/>
                    <Label fx:id="lblAppStatus" text="PENDING" style="-fx-padding: 4 10; -fx-background-color: #fff3e0; -fx-text-fill: #ffa000; -fx-background-radius: 4; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                </HBox>
                <HBox spacing="40">
                    <VBox spacing="5">
                        <Label text="Requested Budget (DT)" style="-fx-text-fill: #5e6d55; -fx-font-size: 12px;"/>
                        <Label fx:id="lblAppBudget" text="0.00 DT" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Estimated Timeline" style="-fx-text-fill: #5e6d55; -fx-font-size: 12px;"/>
                        <Label fx:id="lblAppDuration" text="0 Days" style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    </VBox>
                </HBox>
                <Separator/>
                <VBox spacing="10">
                    <Label text="Cover Letter" style="-fx-font-weight: bold;"/>
                    <TextFlow style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e4ebe4; -fx-border-radius: 8;">
                         <Text fx:id="txtDetailAppCoverLetter" style="-fx-fill: #001e00; -fx-font-size: 14px;"/>
                    </TextFlow>
                </VBox>
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 20 0;">
                    <Button onAction="#handleExportPdf" text="Export PDF" style="-fx-background-color: #00457c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;"/>
                    <Button onAction="#handleEdit" text="Modify" style="-fx-background-color: white; -fx-text-fill: #00457c; -fx-border-color: #00457c; -fx-border-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;"/>
                    <Button onAction="#handleDelete" text="Delete" style="-fx-background-color: transparent; -fx-text-fill: #d93025; -fx-border-color: #d93025; -fx-border-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
            
            <!-- EVALUATION DETAILS -->
            <VBox fx:id="viewEvalDetails" spacing="25" visible="false">
                <VBox spacing="10">
                    <Label fx:id="lblEvalRating" text="★★★★★" style="-fx-font-size: 32px; -fx-text-fill: #ffa000;"/>
                    <Label fx:id="lblEvalTarget" text="Client Feedback" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                </VBox>
                <Separator/>
                <VBox spacing="10">
                    <Label text="Comment" style="-fx-font-weight: bold;"/>
                    <TextFlow style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #e4ebe4; -fx-border-radius: 8;">
                         <Text fx:id="txtDetailEvalComment" style="-fx-fill: #001e00; -fx-font-size: 14px;"/>
                    </TextFlow>
                </VBox>
                <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 20 0;">
                    <Button onAction="#handleAnalyzeSentiment" text="Analyze Tone" style="-fx-background-color: #00457c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;"/>
                    <Button onAction="#handleDelete" text="Delete" style="-fx-background-color: transparent; -fx-text-fill: #d93025; -fx-border-color: #d93025; -fx-border-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- STATS VIEW -->
            <VBox fx:id="viewStats" spacing="30" visible="false">
                <Label text="Global Performance" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <FlowPane hgap="25" vgap="25">
                    <VBox prefWidth="240" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 1);">
                        <Label text="Total Earnings" style="-fx-text-fill: #5e6d55; -fx-font-size: 14px;"/>
                        <Label fx:id="lblStatEarnings" text="0.00 DT" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #00457c; -fx-padding: 10 0;"/>
                        <Button onAction="#handleConvertCurrency" text="Convert to USD" style="-fx-background-color: transparent; -fx-text-fill: #14a800; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;"/>
                    </VBox>
                    <VBox prefWidth="240" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 1);">
                        <Label text="Success Rate" style="-fx-text-fill: #5e6d55; -fx-font-size: 14px;"/>
                        <Label fx:id="lblStatSuccess" text="0%" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #14a800; -fx-padding: 10 0;"/>
                        <ProgressBar fx:id="pbStatSuccess" progress="0.0" prefWidth="200" style="-fx-accent: #14a800;"/>
                    </VBox>
                </FlowPane>
            </VBox>

            <!-- APPLICATION FORM -->
            <VBox fx:id="viewAppForm" spacing="20" visible="false" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12;">
               <Label text="Apply for Project" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
               <GridPane hgap="20" vgap="15">
                    <VBox spacing="5" GridPane.columnIndex="0">
                        <Label text="Project ID"/>
                        <TextField fx:id="txtAppProjectId"/>
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="1">
                         <Label text="Freelancer ID (Read Only)"/>
                         <TextField fx:id="txtAppFreelancerId" editable="false" style="-fx-background-color: #f4f7f6;"/>
                    </VBox>
               </GridPane>
               <HBox spacing="20">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Proposed Budget (DT)"/>
                        <TextField fx:id="txtAppBudget"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                         <Label text="Duration (Days)"/>
                         <TextField fx:id="txtAppDuration"/>
                    </VBox>
               </HBox>
               <VBox spacing="5">
                    <Label text="Cover Letter (Min 20 characters)"/>
                    <TextArea fx:id="txtAppCoverLetter" prefHeight="150" wrapText="true"/>
               </VBox>
               <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button text="Cancel" onAction="#handleCancelForm" style="-fx-background-color: transparent; -fx-text-fill: #5e6d55; -fx-cursor: hand;"/>
                    <Button onAction="#handleSubmitApp" text="Send Proposal" style="-fx-background-color: #14a800; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- EVALUATION FORM -->
            <VBox fx:id="viewEvalForm" spacing="20" visible="false" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12;">
               <Label text="Rate Client" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
               <GridPane hgap="20" vgap="15">
                    <VBox spacing="5" GridPane.columnIndex="0">
                        <Label text="Client ID"/>
                        <TextField fx:id="txtEvalTarget"/>
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="1">
                         <CheckBox fx:id="chkEvalIsProject" text="Link to project?"/>
                         <TextField fx:id="txtEvalProjId" promptText="Project ID (if related)"/>
                    </VBox>
               </GridPane>
               <VBox spacing="10">
                    <Label text="Rating"/>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                         <Slider fx:id="sliderEvalRating" min="1" max="5" value="5" majorTickUnit="1" minorTickCount="0" snapToTicks="true" prefWidth="300"/>
                         <Label fx:id="lblEvalRatingValue" text="5 Stars" style="-fx-font-weight: bold; -fx-text-fill: #ffa000;"/>
                    </HBox>
               </VBox>
               <VBox spacing="5">
                    <Label text="Feedback Comment (Min 15 chars)"/>
                    <TextArea fx:id="txtEvalComment" prefHeight="100" wrapText="true"/>
               </VBox>
               <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Button text="Cancel" onAction="#handleCancelForm" style="-fx-background-color: transparent; -fx-text-fill: #5e6d55; -fx-cursor: hand;"/>
                    <Button onAction="#handleSubmitEval" text="Post Review" style="-fx-background-color: #14a800; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 25; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <VBox fx:id="messageContainer" alignment="CENTER" fillWidth="false" managed="true" mouseTransparent="true" pickOnBounds="false" visible="false">
                <StackPane.alignment>BOTTOM_CENTER</StackPane.alignment>
                <Label fx:id="lblMessage" style="-fx-text-fill: white; -fx-padding: 10 20; -fx-font-weight: bold;"/>
            </VBox>
        </StackPane>
    </children>
</HBox>
