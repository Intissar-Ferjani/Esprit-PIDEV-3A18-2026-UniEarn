<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane" prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.application.LoadingController">
    <children>
        <MediaView fx:id="mediaView" fitHeight="700.0" fitWidth="1200.0" preserveRatio="true" />
        <VBox alignment="BOTTOM_CENTER" mouseTransparent="true" spacing="20" style="-fx-padding: 0 0 50 0;">
            <Label fx:id="lblLoading" text="Loading UniEarn..." style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" visible="false"/>
        </VBox>
    </children>
</StackPane>
