<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="home-root" stylesheets="@home.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniearn.controller.home.HomePageController">

    <!-- ═══════════════════════════════════════════ NAVBAR ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="86.0" prefWidth="1100.0" spacing="0.0" styleClass="navbar">
            <padding><Insets left="40.0" right="40.0" /></padding>
            <children>

                <!-- Logo -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <ImageView fitHeight="80.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../images/logoUniEarn.png" />
                            </image>
                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>
                        </ImageView>
                        <Label styleClass="nav-logo" text="UniEarn" />
                    </children>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Nav Links -->
                <HBox alignment="CENTER" spacing="32.0">
                    <children>
                        <Button onAction="#handleFeatures" styleClass="nav-link" text="Fonctionnalités" />
                        <Button onAction="#handlePricing" styleClass="nav-link" text="Tarifs" />
                        <Button onAction="#handleAbout" styleClass="nav-link" text="À propos" />
                    </children>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Auth Buttons -->
                <HBox alignment="CENTER" spacing="12.0">
                    <children>
                        <Button onAction="#handleLogin" styleClass="nav-login-btn" text="Connexion" />
                        <Button onAction="#handleSignup" styleClass="nav-signup-btn" text="S'inscrire" />
                    </children>
                </HBox>

            </children>
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════ MAIN CONTENT ═══ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="home-scroll">
            <content>
                <VBox spacing="0.0">
                    <children>

                        <!-- ── HERO SECTION ── -->
                        <VBox alignment="CENTER" spacing="24.0" styleClass="hero-section">
                            <padding><Insets bottom="80.0" left="120.0" right="120.0" top="80.0" /></padding>
                            <children>

                                <!-- Badge -->
                                <HBox alignment="CENTER">
                                    <children>
                                        <Label styleClass="hero-badge" text="☆  Plateforme #1 pour étudiants freelances" />
                                    </children>
                                </HBox>

                                <!-- Main Headline -->
                                <VBox alignment="CENTER" spacing="4.0">
                                    <children>
                                        <Label styleClass="hero-title-black" text="Travaillez en freelance" wrapText="true">
                                            <font><Font name="System Bold" size="52.0" /></font>
                                        </Label>
                                        <Label styleClass="hero-title-blue" text="pendant vos études" wrapText="true">
                                            <font><Font name="System Bold" size="52.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>

                                <!-- Subtitle -->
                                <Label maxWidth="520.0" styleClass="hero-subtitle" text="Trouvez des missions adaptées à votre emploi du temps étudiant.&#10;Paiements sécurisés, clients vérifiés, et support dédié." textAlignment="CENTER" wrapText="true" />

                                <!-- CTA Buttons -->
                                <HBox alignment="CENTER" spacing="16.0">
                                    <VBox.margin><Insets top="8.0" /></VBox.margin>
                                    <children>
                                        <Button onAction="#handleSignup" styleClass="cta-primary" text="Commencer gratuitement  →" />
                                        <Button onAction="#handleBrowse" styleClass="cta-secondary" text="Voir les missions" />
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                        <!-- ── STATS BAR ── -->
                        <HBox alignment="CENTER" spacing="0.0" styleClass="stats-bar">
                            <padding><Insets bottom="32.0" top="32.0" /></padding>
                            <children>

                                <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-number-dark" text="5,000+" />
                                        <Label styleClass="stat-label-gray" text="Étudiants actifs" />
                                    </children>
                                </VBox>

                                <Separator orientation="VERTICAL" prefHeight="50.0" styleClass="stat-divider" />

                                <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-number-green" text="98%" />
                                        <Label styleClass="stat-label-gray" text="Paiements réussis" />
                                    </children>
                                </VBox>

                                <Separator orientation="VERTICAL" prefHeight="50.0" styleClass="stat-divider" />

                                <VBox alignment="CENTER" spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-number-blue" text="150+" />
                                        <Label styleClass="stat-label-gray" text="Campus partenaires" />
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <!-- ── FEATURES SECTION ── -->
                        <VBox alignment="CENTER" spacing="40.0" styleClass="features-section">
                            <padding><Insets bottom="70.0" left="80.0" right="80.0" top="70.0" /></padding>
                            <children>

                                <VBox alignment="CENTER" spacing="10.0">
                                    <children>
                                        <Label styleClass="section-title" text="Pourquoi choisir UniEarn ?" />
                                        <Label styleClass="section-subtitle" text="Tout ce dont vous avez besoin pour réussir en freelance pendant vos études" textAlignment="CENTER" wrapText="true" />
                                    </children>
                                </VBox>

                                <HBox alignment="CENTER" spacing="24.0">
                                    <children>

                                        <VBox spacing="14.0" styleClass="feature-card" HBox.hgrow="ALWAYS">
                                            <padding><Insets bottom="28.0" left="24.0" right="24.0" top="28.0" /></padding>
                                            <children>
                                                <Label style="-fx-font-size:32px;" text="🛡️" />
                                                <Label styleClass="feature-title" text="Paiements sécurisés" />
                                                <Label styleClass="feature-desc" text="Votre argent est protégé jusqu'à la livraison du travail. Zéro risque d'impayé." wrapText="true" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="14.0" styleClass="feature-card feature-card-blue" HBox.hgrow="ALWAYS">
                                            <padding><Insets bottom="28.0" left="24.0" right="24.0" top="28.0" /></padding>
                                            <children>
                                                <Label style="-fx-font-size:32px;" text="⏰" />
                                                <Label styleClass="feature-title-white" text="Flexible &amp; Adapté" />
                                                <Label styleClass="feature-desc-white" text="Choisissez des missions compatibles avec votre emploi du temps universitaire." wrapText="true" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="14.0" styleClass="feature-card" HBox.hgrow="ALWAYS">
                                            <padding><Insets bottom="28.0" left="24.0" right="24.0" top="28.0" /></padding>
                                            <children>
                                                <Label style="-fx-font-size:32px;" text="✅" />
                                                <Label styleClass="feature-title" text="Clients vérifiés" />
                                                <Label styleClass="feature-desc" text="Tous nos clients passent par une vérification stricte. Travaillez en toute confiance." wrapText="true" />
                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                        <!-- ── HOW IT WORKS ── -->
                        <VBox alignment="CENTER" spacing="40.0" styleClass="steps-section">
                            <padding><Insets bottom="70.0" left="80.0" right="80.0" top="70.0" /></padding>
                            <children>

                                <Label styleClass="section-title" text="Comment ça marche ?" />

                                <HBox alignment="CENTER" spacing="0.0">
                                    <children>

                                        <VBox alignment="CENTER" spacing="14.0" styleClass="step-item" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane styleClass="step-circle">
                                                    <children>
                                                        <Label styleClass="step-number" text="1" />
                                                    </children>
                                                </StackPane>
                                                <Label styleClass="step-title" text="Créez votre profil" />
                                                <Label maxWidth="180.0" styleClass="step-desc" text="Ajoutez vos compétences et votre carte étudiante pour être vérifié." textAlignment="CENTER" wrapText="true" />
                                            </children>
                                        </VBox>

                                        <Region prefWidth="30.0" />
                                        <Label styleClass="step-arrow" text="──────" />
                                        <Region prefWidth="30.0" />

                                        <VBox alignment="CENTER" spacing="14.0" styleClass="step-item" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane styleClass="step-circle">
                                                    <children>
                                                        <Label styleClass="step-number" text="2" />
                                                    </children>
                                                </StackPane>
                                                <Label styleClass="step-title" text="Trouvez des missions" />
                                                <Label maxWidth="180.0" styleClass="step-desc" text="Parcourez les projets adaptés à vos compétences et disponibilités." textAlignment="CENTER" wrapText="true" />
                                            </children>
                                        </VBox>

                                        <Region prefWidth="30.0" />
                                        <Label styleClass="step-arrow" text="──────" />
                                        <Region prefWidth="30.0" />

                                        <VBox alignment="CENTER" spacing="14.0" styleClass="step-item" HBox.hgrow="ALWAYS">
                                            <children>
                                                <StackPane styleClass="step-circle">
                                                    <children>
                                                        <Label styleClass="step-number" text="3" />
                                                    </children>
                                                </StackPane>
                                                <Label styleClass="step-title" text="Livrez &amp; Soyez payé" />
                                                <Label maxWidth="180.0" styleClass="step-desc" text="Terminez le projet et recevez votre paiement de manière sécurisée." textAlignment="CENTER" wrapText="true" />
                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                        <!-- ── CTA BANNER ── -->
                        <VBox alignment="CENTER" spacing="20.0" styleClass="cta-banner">
                            <padding><Insets bottom="60.0" left="80.0" right="80.0" top="60.0" /></padding>
                            <children>
                                <Label styleClass="cta-banner-title" text="Prêt à commencer ?" />
                                <Label styleClass="cta-banner-subtitle" text="Rejoignez 5,000+ étudiants qui gagnent de l'expérience et de l'argent sur UniEarn." textAlignment="CENTER" wrapText="true" />
                                <HBox alignment="CENTER" spacing="16.0">
                                    <VBox.margin><Insets top="8.0" /></VBox.margin>
                                    <children>
                                        <Button onAction="#handleSignup" styleClass="cta-banner-btn" text="Créer mon compte gratuitement" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- ── FOOTER ── -->
                        <HBox alignment="CENTER" spacing="40.0" styleClass="footer">
                            <padding><Insets bottom="24.0" left="60.0" right="60.0" top="24.0" /></padding>
                            <children>
                                <Label styleClass="footer-text" text="© 2026 UniEarn — Plateforme de freelancing étudiant" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button styleClass="footer-link" text="Confidentialité" />
                                <Button styleClass="footer-link" text="CGU" />
                                <Button styleClass="footer-link" text="Contact" />
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
