# ═══════════════════════════════════════════════════════════════
# CONFIGURATION STRIPE - UniEarn Java
# ═══════════════════════════════════════════════════════════════

# ── Clés Stripe (Mode Test) ───────────────────────────────────
# Obtenez vos clés sur : https://dashboard.stripe.com/test/apikeys

STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ── Configuration ──────────────────────────────────────────────

# Mode : test | live
STRIPE_MODE=test

# URL de callback après paiement
STRIPE_SUCCESS_URL=uniearn://payment/success
STRIPE_CANCEL_URL=uniearn://payment/cancel

# ── Webhooks (optionnel) ───────────────────────────────────────
# Pour recevoir les notifications de Stripe

STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook_ici

# ═══════════════════════════════════════════════════════════════
# INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════

# 1. Copiez ce fichier en .env (sans .example)
# 2. Remplacez les valeurs par vos vraies clés Stripe
# 3. Ne commitez JAMAIS le fichier .env dans git !
# 4. Pour le mode production, utilisez sk_live_ et pk_live_

# ── Cartes de test Stripe ──────────────────────────────────────
# Carte réussie : 4242 4242 4242 4242
# Carte refusée : 4000 0000 0000 0002
# 3D Secure : 4000 0027 6000 3184
#
# Plus d'infos : https://stripe.com/docs/testing

# ═══════════════════════════════════════════════════════════════

